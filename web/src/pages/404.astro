---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
---

<Base title="Page Not Found" disableTagline={true} fitToScreen={false}>
  <section>
    <div class="container">
      <div class="flex flex-col items-center gap-y-10">
        <div class="space-y-4 text-center text-lg">
          <h1 class="text-8xl sm:text-9xl md:text-[16rem]">404</h1>
          <h2 class="text-h1-sm md:text-h1">Pagina nu există</h2>
          <h2 class="text-h1-sm md:text-h1">Page not found</h2>
          <p></p>
        </div>
        <Button
          class="uppercase"
          label="Înapoi la pagina principală"
          url="/"
          variant="text"
        />
        <Button class="uppercase" label="Back to Home" url="/" variant="text" />
      </div>
    </div>
  </section>
</Base>
