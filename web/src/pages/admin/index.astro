---
export const prerender = false;
import "@/styles/admin.css";
import HugeIcon from "@/components/bearnie/fundations/icons/HugeIcon.astro";
import { Moon01Icon, Sun01Icon } from "@/components/bearnie/lib/hugeicons";
import AdminProductsTable from "@/layouts/components/admin/AdminProductsTable.astro";
import AdminSidebar from "@/layouts/components/admin/AdminSidebar.astro";
import SidebarTrigger from "@/components/bearnie/sidebar/SidebarTrigger.astro";
import Select from "@/components/bearnie/select/Select.astro";
import SelectOption from "@/components/bearnie/select/SelectOption.astro";
import { getPayload } from "payload";
import { config as payloadConfig } from "admin";

const payload = await getPayload({ config: payloadConfig });

const [partnersResult, categoriesResult, materialsResult] = await Promise.all([
  payload.find({ collection: "partners", limit: 0, sort: "name", select: { name: true } }),
  payload.find({ collection: "categories", limit: 0, sort: "name", select: { name: true } }),
  payload.find({ collection: "materials", limit: 0, sort: "name", select: { name: true } }),
]);

const partnerOptions = partnersResult.docs.map((p) => ({ id: p.id, name: p.name }));
const categoryOptions = categoriesResult.docs.map((c) => ({ id: c.id, name: c.name }));
const materialOptions = materialsResult.docs.map((m) => ({ id: m.id, name: m.name }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Products · Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme") || "light";
        document.documentElement.classList.toggle("dark", stored === "dark");
      })();
    </script>
  </head>
  <body>
    <div class="flex min-h-screen">
      <AdminSidebar currentPath={Astro.url.pathname} />

      <div class="flex flex-1 flex-col">
        <header class="sticky top-0 z-30 flex items-center gap-3 bg-background px-4 py-3 shadow-sm">
          <SidebarTrigger for="admin-sidebar" />
          <h1 class="text-2xl font-semibold">Products</h1>
          <p class="text-muted-foreground text-sm">Admin product list</p>

          <button
            type="button"
            class="ml-auto cursor-pointer rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            data-theme-toggle
            aria-label="Toggle theme">
            <HugeIcon icon={Sun01Icon as never} class="size-5 hidden dark:block" />
            <HugeIcon icon={Moon01Icon as never} class="size-5 block dark:hidden" />
          </button>
        </header>

        <main class="flex-1 overflow-x-auto px-6 py-6">
          <div class="mb-4 flex items-center gap-4">
            <Select name="limit" class="w-40" data-per-page>
              <SelectOption value="10">10 per page</SelectOption>
              <SelectOption value="50">50 per page</SelectOption>
              <SelectOption value="all">All</SelectOption>
            </Select>
          </div>

          <AdminProductsTable
            partners={partnerOptions}
            categories={categoryOptions}
            materials={materialOptions}
          />
        </main>
      </div>
    </div>

    <script>
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const isDark = document.documentElement.classList.contains("dark");
          const newTheme = isDark ? "light" : "dark";
          localStorage.setItem("theme", newTheme);
          document.documentElement.classList.toggle("dark", newTheme === "dark");
        });
      });
    </script>
    <script>
      const select = document.querySelector(
        "[data-per-page]",
      ) as HTMLSelectElement;
      const current =
        new URLSearchParams(window.location.search).get("limit") ?? "10";
      select.value = current;
      select.addEventListener("change", () => {
        const url = new URL(window.location.href);
        url.searchParams.set("limit", select.value);
        url.searchParams.delete("page");
        window.location.href = url.pathname + url.search;
      });
    </script>
  </body>
</html>
