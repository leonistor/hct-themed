---
export const prerender = false;
import "@/styles/admin.css";
import Icon from "@/components/ui/basecoat/Icon.astro";
import {
  Menu01Icon,
  Moon01Icon,
  Sun01Icon,
} from "@/components/ui/basecoat/hugeicons";
import Favicons from "@/components/seo/Favicons.astro";
import AdminProductsTable from "@/layouts/components/admin/AdminProductsTable.astro";
import AdminSidebar from "@/layouts/components/admin/AdminSidebar.astro";
import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import { getAdminUser } from "@/utils/adminAuth";

const payload = await getPayload({ config: payloadConfig });

const currentUser = await getAdminUser(payload, Astro.request);
if (!currentUser) {
  return Astro.redirect("/admin/login");
}

const [partnersResult, categoriesResult, materialsResult] = await Promise.all([
  payload.find({
    collection: "partners",
    limit: 0,
    sort: "name",
    select: { name: true },
  }),
  payload.find({
    collection: "categories",
    limit: 0,
    sort: "name",
    select: { name: true },
  }),
  payload.find({
    collection: "materials",
    limit: 0,
    sort: "name",
    select: { name: true },
  }),
]);

const partnerOptions = partnersResult.docs.map((p) => ({
  id: p.id,
  name: p.name,
}));
const categoryOptions = categoriesResult.docs.map((c) => ({
  id: c.id,
  name: c.name,
}));
const materialOptions = materialsResult.docs.map((m) => ({
  id: m.id,
  name: m.name,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Products · Admin</title>
    <Favicons />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme") || "light";
        document.documentElement.classList.toggle("dark", stored === "dark");
      })();
    </script>
  </head>
  <body class="admin-page">
    <div class="admin-shell flex min-h-screen">
      <AdminSidebar
        currentPath={Astro.url.pathname}
        userEmail={currentUser.email}
      />

      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="bg-background/95 sticky top-0 z-30 flex items-center gap-3 border-b px-4 py-3 backdrop-blur">
          <button
            type="button"
            aria-label="Toggle sidebar"
            class="btn"
            data-variant="ghost"
            data-size="icon-sm"
            aria-controls="admin-sidebar"
            aria-expanded="true"
            data-sidebar-toggle>
            <Icon icon={Menu01Icon} class="size-4" />
          </button>
          <div>
            <h1 class="text-lg font-semibold tracking-tight">Products</h1>
            <p class="text-muted-foreground hidden text-sm sm:block">
              Admin product list
            </p>
          </div>

          <button
            type="button"
            class="btn ml-auto"
            data-variant="ghost"
            data-size="icon-sm"
            data-theme-toggle
            aria-label="Toggle theme">
            <Icon icon={Sun01Icon} class="hidden size-5 dark:block" />
            <Icon icon={Moon01Icon} class="block size-5 dark:hidden" />
          </button>
        </header>

        <main class="min-w-0 flex-1 overflow-x-auto px-6 py-6">
          <AdminProductsTable
            partners={partnerOptions}
            categories={categoryOptions}
            materials={materialOptions}
          />
        </main>
      </div>
    </div>

    <script>
      const sidebar = document.getElementById("admin-sidebar") as
        | (HTMLElement & { toggle?: () => void })
        | null;
      const sidebarToggle = document.querySelector("[data-sidebar-toggle]");

      function syncSidebarToggle() {
        if (!sidebar || !sidebarToggle) return;
        sidebarToggle.setAttribute(
          "aria-expanded",
          String(sidebar.getAttribute("aria-hidden") !== "true"),
        );
      }

      sidebar?.addEventListener("basecoat:initialized", syncSidebarToggle);
      sidebarToggle?.addEventListener("click", () => {
        sidebar?.toggle?.();
        requestAnimationFrame(syncSidebarToggle);
      });

      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const isDark = document.documentElement.classList.contains("dark");
          const newTheme = isDark ? "light" : "dark";
          localStorage.setItem("theme", newTheme);
          document.documentElement.classList.toggle(
            "dark",
            newTheme === "dark",
          );
        });
      });
    </script>

    <script>
      import("basecoat-css/basecoat").then(async () => {
        await Promise.all([
          import("basecoat-css/sidebar"),
          import("basecoat-css/drawer"),
          import("basecoat-css/accordion"),
          import("basecoat-css/select"),
        ]);
        window.basecoat?.initAll();
      });
    </script>
  </body>
</html>
