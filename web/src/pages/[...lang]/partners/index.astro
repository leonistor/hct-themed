---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import { getPayload } from "payload";
import { config as payloadConfig, type Media } from "admin";
import PartnerCard from "@/layouts/components/cards/PartnerCard.astro";
import PageTitle from "@/layouts/components/ui/PageTitle.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";

const payload = await getPayload({ config: payloadConfig });

const partners = await payload.find({
  collection: "partners",
  depth: 2,
  sort: "_order",
  where: { published: { equals: true } },
});

const t = await useTranslations(Astro.currentLocale as string);

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("about-us", "-index", Astro.currentLocale);
---

<Base {...page?.data} hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <PageTitle title={t("partners.title")} />
      <div class="pb-4 md:text-xl">{t("partners.tagline")}</div>
      <div
        class="grid grid-cols-1 gap-x-4 gap-y-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
        {
          partners.docs.map((partner, index) => (
            <PartnerCard partner={partner} index={index} />
          ))
        }
      </div>
    </div>
  </section>
</Base>
