---
export const prerender = false;

import Base from "@/layouts/Base.astro";
import PageTitle from "@/layouts/components/ui/PageTitle.astro";
import ProductsGrid from "@/layouts/components/ui/ProductsGrid.astro";
import { Image } from "astro:assets";

import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import type { Media } from "shared";

const payload = await getPayload({ config: payloadConfig });

const { code } = Astro.params;

const partner_docs = await payload.find({
  collection: "partners",
  pagination: false,
  limit: 1,
  where: { code: { equals: code } },
});

if (!partner_docs) {
  return Astro.redirect("/404");
}

const partner = partner_docs.docs[0];
---

<Base hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <div
        class="mb-2 grid grid-cols-1 gap-2 bg-white p-2 md:mb-6 md:grid-cols-2 md:gap-6 md:p-6">
        <div>
          <PageTitle title={partner.name} />
          <div class="pb-4 md:text-xl">{partner.description}</div>
          <a
            href={partner.url}
            class="hover:text-primary text-gray-500"
            target="_blank">
            {partner.url}
          </a>
        </div>
        <div>
          <Image
            src={(partner.logo! as Media).url!}
            width={360}
            height={100}
            alt={partner.name}
          />
        </div>
      </div>
      <ProductsGrid partner_code={partner.code} />
    </div>
  </section>
</Base>
