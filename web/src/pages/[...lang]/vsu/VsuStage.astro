---
export const prerender = false;

import AccordionItem from "@/components/bearnie/accordion/AccordionItem.astro";
import AccordionTrigger from "@/components/bearnie/accordion/AccordionTrigger.astro";
import AccordionContent from "@/components/bearnie/accordion/AccordionContent.astro";

export interface Props {
  title: string;
  description: string;
  defaultOpen?: boolean;
}
const { title, description, defaultOpen = false } = Astro.props;
---

<AccordionItem value="item-1" class="border-primary/50 border-4 px-4">
  <AccordionTrigger class="text-left">
    <div class="flex flex-col items-start gap-1">
      <span class="text-accent text-3xl font-medium">{title}</span>
      <span class="text-muted-foreground leading-snug font-normal">
        {description}
      </span>
    </div>
  </AccordionTrigger>
  <AccordionContent defaultOpen={defaultOpen}><slot /></AccordionContent>
</AccordionItem>
