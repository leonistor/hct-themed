---
import AccordionItem from "@/components/bearnie/accordion/AccordionItem.astro";
import AccordionTrigger from "@/components/bearnie/accordion/AccordionTrigger.astro";
import AccordionContent from "@/components/bearnie/accordion/AccordionContent.astro";

const { title, description } = Astro.props;
---

<AccordionItem value="item-1" class="border-primary/50 border-4 px-4">
  <AccordionTrigger>
    <div class="flex flex-col items-start gap-1">
      <span class="text-2xl font-medium">{title}</span>
      <span class="text-muted-foreground font-normal">
        {description}
      </span>
    </div>
  </AccordionTrigger>
  <AccordionContent><slot /></AccordionContent>
</AccordionItem>
