---
export const prerender = false;

export interface Props {
  title: string;
  description: string;
  defaultOpen?: boolean;
}
const { title, description, defaultOpen = false } = Astro.props;
---

<details class="border-primary/50 border-4 px-4" open={defaultOpen}>
  <summary
    class="flex w-full flex-1 items-center justify-between py-4 text-left font-medium transition-all hover:TextUnderlineIcon">
    <div class="flex flex-col items-start gap-1">
      <span class="text-accent text-3xl font-medium">{title}</span>
      <span class="text-muted-foreground leading-snug font-normal">
        {description}
      </span>
    </div>
  </summary>
  <section class="overflow-hidden text-sm transition-all pb-4 pt-0">
    <slot />
  </section>
</details>
