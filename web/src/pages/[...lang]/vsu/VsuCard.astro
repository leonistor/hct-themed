---
export const prerender = false;

type Props = {
  code?: string;
  name?: string;
};
let { code, name } = Astro.props;
---

<a
  href={`/product/${code}`}
  class:list={[
    "text-primary lg:text-h6 xl:text-h5 bg-gray-100 text-lg",
    "opacity-80 hover:opacity-100",
    "px-3 py-1",
    "leading-tight font-medium tracking-tight text-balance",
  ]}
  aria-label={name}>
  {name?.slice(8)}
</a>
