---
export const prerender = false;

import type { Category, Material, Media, Partner, Product } from "admin";

type Props = {
  index?: number;
  product: Product;
};
let { index = 0, product } = Astro.props;
---

<a
  href={`/product/${product.code}`}
  class:list={[
    "text-primary lg:text-h6 xl:text-h5 bg-gray-100 text-lg",
    "opacity-80 hover:opacity-100",
    "px-3 py-1",
    "leading-tight font-medium tracking-tight text-balance",
  ]}
  aria-label={product.name}>
  {product.name.slice(8)}
</a>
