---
export const prerender = false;

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="border-t-accent/40 my-4 border-t-4 pt-2">
  <h3 class="text-accent pt-2 pb-4 text-xl font-medium">{title}</h3>
  <div
    class:list={[
      "grid grid-cols-1 gap-x-2 gap-y-4",
      "md:grid-cols-2 lg:grid-cols-3 lg:gap-x-3 lg:gap-y-5",
      ,
    ]}>
    <slot />
  </div>
</div>
