---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import PageHeader from "@/components/widgets/PageHeader.astro";
import AboutSectionTwo from "@/components/sections/AboutSectionTwo.astro";
import TeamSection from "@/components/sections/TeamSection.astro";
import AboutMetricsSection from "@/components/sections/AboutMetricsSection.astro";
import StatsMarqueeSection from "@/components/sections/StatsMarqueeSection.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";
import PageTitle from "@/layouts/components/ui/PageTitle.astro";

import { Image } from "astro:assets";
import logo_iris_mec from "@/assets/images/vsu/logo-iris-mec.jpg";

import Accordion from "@/components/bearnie/accordion/Accordion.astro";
import AccordionItem from "@/components/bearnie/accordion/AccordionItem.astro";
import AccordionTrigger from "@/components/bearnie/accordion/AccordionTrigger.astro";
import AccordionContent from "@/components/bearnie/accordion/AccordionContent.astro";

export function getStaticPaths() {
  return generatePaths();
}

const t = await useTranslations(Astro.currentLocale as string);
---

<Base metaTitle={t("vsu.headline")} hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <div class="mb-4">
        <h1
          data-aos="reveal-anim-top"
          data-aos-offset="0"
          data-aos-duration="400"
          class:list={["text-h2-sm text-primary lg:text-h1-sm xl:text-h1"]}>
          {t("vsu.headline")}
          <Image
            src={logo_iris_mec}
            alt="Iris Mec"
            height={90}
            class="inline-block rounded-md"
          />
        </h1>
      </div>

      <Accordion type="single" class="space-y-2">
        <AccordionItem value="item-1" class="rounded-lg border px-4">
          <AccordionTrigger>Getting Started</AccordionTrigger>
          <AccordionContent>
            Follow our quick start guide to set up your first project.
          </AccordionContent>
        </AccordionItem>
        <AccordionItem value="item-2" class="rounded-lg border px-4">
          <AccordionTrigger>Configuration</AccordionTrigger>
          <AccordionContent>
            Learn how to customize Settings01Icon to fit your needs.
          </AccordionContent>
        </AccordionItem>
        <AccordionItem value="item-3" class="rounded-lg border px-4">
          <AccordionTrigger>Advanced Usage</AccordionTrigger>
          <AccordionContent>
            Explore advanced features and integrations.
          </AccordionContent>
        </AccordionItem>
      </Accordion>
      <!--  -->
    </div>
  </section>
</Base>
