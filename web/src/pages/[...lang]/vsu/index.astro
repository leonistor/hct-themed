---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import PageHeader from "@/components/widgets/PageHeader.astro";
import AboutSectionTwo from "@/components/sections/AboutSectionTwo.astro";
import TeamSection from "@/components/sections/TeamSection.astro";
import AboutMetricsSection from "@/components/sections/AboutMetricsSection.astro";
import StatsMarqueeSection from "@/components/sections/StatsMarqueeSection.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";
import PageTitle from "@/layouts/components/ui/PageTitle.astro";

import { Image } from "astro:assets";
import logo_iris_mec from "@/assets/images/vsu/logo-iris-mec.jpg";

import Accordion from "@/components/bearnie/accordion/Accordion.astro";
import AccordionItem from "@/components/bearnie/accordion/AccordionItem.astro";
import AccordionTrigger from "@/components/bearnie/accordion/AccordionTrigger.astro";
import AccordionContent from "@/components/bearnie/accordion/AccordionContent.astro";

export function getStaticPaths() {
  return generatePaths();
}

const t = await useTranslations(Astro.currentLocale as string);
---

<Base metaTitle={t("vsu.headline")} hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <div class="mb-4">
        <h1
          data-aos="reveal-anim-top"
          data-aos-offset="0"
          data-aos-duration="400"
          class:list={["text-h2-sm text-primary lg:text-h1-sm xl:text-h1"]}>
          {t("vsu.headline")}
          <Image
            src={logo_iris_mec}
            alt="Iris Mec"
            height={90}
            class="inline-block rounded-md"
          />
        </h1>
      </div>

      <Accordion type="multiple" class="space-y-4">
        <!-- 1 -->
        <AccordionItem value="item-1" class="border px-4">
          <AccordionTrigger>
            <div class="flex flex-col items-start gap-1">
              <span>Depoluare</span>
              <span class="text-muted-foreground text-sm font-normal">
                Îndepărtarea din vehicul a tuturor fluidelor, gazelor sau
                elementelor care pot fi potențial periculoase pentru siguranță
                sau pentru mediu.
              </span>
            </div>
          </AccordionTrigger>
          <AccordionContent> 1 content </AccordionContent>
        </AccordionItem>
        <!-- 2 -->
        <AccordionItem value="item-2" class="border px-4">
          <AccordionTrigger>
            <div class="flex flex-col items-start gap-1">
              <span>Dezasamblare</span>
              <span class="text-muted-foreground text-sm font-normal">
                Separarea componentelor și materialelor solide ale vehiculelor
                scoase din uz, cum ar fi metalul, plasticul și sticla.
              </span>
            </div>
          </AccordionTrigger>
          <AccordionContent> 2 content </AccordionContent>
        </AccordionItem>
        <!-- 3 -->
        <AccordionItem value="item-3" class="border px-4">
          <AccordionTrigger>
            <div class="flex flex-col items-start gap-1">
              <span>Depozitare</span>
              <span class="text-muted-foreground text-sm font-normal">
                Estetica și imaginea de ordine, curățenie și organizare
                reprezintă întotdeauna o valoare pozitivă.
              </span>
            </div>
          </AccordionTrigger>
          <AccordionContent> 3 content </AccordionContent>
        </AccordionItem>
        <!-- 4 -->
        <AccordionItem value="item-4" class="border px-4">
          <AccordionTrigger>
            <div class="flex flex-col items-start gap-1">
              <span>Vehicule electrice și hibride</span>
              <span class="text-muted-foreground text-sm font-normal">
                Echipamente pentru gestionarea și depozitarea componentelor de
                înaltă tensiune ale vehiculelor electrice și hibride.
              </span>
            </div>
          </AccordionTrigger>
          <AccordionContent> 4 content </AccordionContent>
        </AccordionItem>
      </Accordion>
    </div>
  </section>
</Base>
