---
export const prerender = false;

import Base from "@/layouts/Base.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";

import { Image } from "astro:assets";
import logo_iris_mec from "@/assets/images/vsu/logo-iris-mec.jpg";
import Accordion from "@/components/bearnie/accordion/Accordion.astro";
import VsuStage from "./VsuStage.astro";
import VsuGrid from "./VsuGrid.astro";
import VsuCard from "./VsuCard.astro";

const t = await useTranslations(Astro.currentLocale as string);

import { getPayload } from "payload";
import { config as payloadConfig, type Media } from "admin";
const payload = await getPayload({ config: payloadConfig });

const vsu_prods = (
  await payload.find({
    collection: "products",
    pagination: false,
    where: { partner: { equals: 6 } },
  })
).docs;

// vsu_map
const vm = new Map(vsu_prods.map((p) => [p.id, p]));
---

<Base metaTitle={t("vsu.headline")} hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <div class="mb-8 space-y-4">
        <h1
          data-aos="reveal-anim-top"
          data-aos-offset="0"
          data-aos-duration="400"
          class:list={["text-h2-sm text-primary lg:text-h1-sm xl:text-h1"]}>
          {t("vsu.headline")}
          <Image
            src={logo_iris_mec}
            alt="Iris Mec"
            height={90}
            class="inline-block rounded-md"
          />
        </h1>
        <p class="text-lg">
          O instalație de reciclare auto este organizată în zone care reflectă
          diferite etape, de la transportul și manipularea vehiculelor până la
          depozitarea și asigurarea transportului diferitelor deșeuri pentru
          recuperarea finală sau depozitarea acestora.
        </p>
      </div>

      <Accordion type="multiple" class="space-y-4">
        <!-- 1 -->
        <VsuStage
          title="Depoluare"
          description="Îndepărtarea din vehicul a tuturor fluidelor, gazelor sau elementelor care pot fi potențial periculoase pentru siguranță sau pentru mediu."
          defaultOpen>
          <p>
            Stațiile <a class="underline" href="/partners/irismec">Iris-Mec</a> sunt
            dotate cu sisteme integrate de aspirație și stocare; oferind posibilitatea
            de aspirare a fluidelor din 4 până la 5 linii, aspirație a combustibilului
            din 2 până la 3 linii și stocare internă integrată a fluidelor. Întreaga
            zonă de lucru este amplasată pe o grilă antiderapantă.
          </p>

          <VsuGrid
            title="Manevrarea mașinii, extragerea și depozitarea bateriei">
            <VsuCard product={vm.get(46)!} />
          </VsuGrid>
          <VsuGrid title="Sisteme complete de drenaj">prods</VsuGrid>
          <VsuGrid title="Recuperarea fluidelor">prods</VsuGrid>
          <VsuGrid title="Recuperarea freonului">prods</VsuGrid>
          <VsuGrid
            title="Golirea combustibilului și reutilizarea benzinei și motorinei"
            >prods</VsuGrid
          >
          <VsuGrid title="Drenarea, depozitarea și arderea GPL și GNC"
            >prods</VsuGrid
          >
          <VsuGrid title="Demontarea și neutralizarea airbagurilor"
            >prods</VsuGrid
          >
        </VsuStage>

        <!-- 2 -->
        <VsuStage
          title="Dezasamblare"
          description="Separarea componentelor și materialelor solide ale vehiculelor scoase din uz, cum ar fi metalul, plasticul și sticla.">
          <VsuGrid title="Îndepărtarea componentelor din sticlă">prods</VsuGrid>
          <VsuGrid title="Demontarea motorului, transmisiei și a axelor"
            >prods</VsuGrid
          >
          <VsuGrid
            title="Demontarea și îndepărtarea catalizatorilor și a componentelor metalice"
            >prods</VsuGrid
          >
          <VsuGrid title="Separarea anvelopelor de roți">prods</VsuGrid>
        </VsuStage>

        <!-- 3 -->
        <VsuStage
          title="Depozitare"
          description="Estetica și imaginea de ordine, curățenie și organizare reprezintă întotdeauna o valoare pozitivă.">
          <VsuGrid title="">prods</VsuGrid>
        </VsuStage>

        <!-- 4 -->
        <VsuStage
          title="Vehicule electrice și hibride"
          description="Echipamente pentru gestionarea și depozitarea componentelor de înaltă tensiune ale vehiculelor electrice și hibride.">
          <VsuGrid title="Demontarea bateriei">prods</VsuGrid>
          <VsuGrid title="Depozitarea bateriei">prods</VsuGrid>
        </VsuStage>
      </Accordion>
    </div>
  </section>
</Base>
