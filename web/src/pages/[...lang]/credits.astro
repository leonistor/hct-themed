---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";
const t = await useTranslations(Astro.currentLocale as string);

import { Content } from "@/content/credits.md";
import PromosOverview from "@/layouts/components/ui/PromosOverview.astro";

export function getStaticPaths() {
  return generatePaths();
}
---

<Base title="Credits">
  <section>
    <div class="container">
      <PromosOverview />
    </div>
    <div class="container">
      <h1>{t("common.credits")}</h1>
      <Content />
    </div>
  </section>
</Base>

<style is:global>
  .credits a {
    text-decoration: underline;
  }
  .credits h1,
  h2,
  h3 {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }
  .credits .photos {
    column-count: auto;
    column-width: 20rem;

    & ul {
      list-style: square;
    }
  }
</style>
