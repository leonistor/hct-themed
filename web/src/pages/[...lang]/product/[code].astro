---
export const prerender = false;

import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Pill from "@/components/ui/Pill.astro";
import ProductGallery from "@/components/ui/ProductGallery.astro";
import ProductVariants from "@/components/ui/ProductVariants.astro";
import Icons from "@/helpers/Icons.astro";
import Button from "@/layouts/components/Button.astro";

import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import type { Media, Partner, Category, Material, Product } from "admin";
const payload = await getPayload({ config: payloadConfig });

import { useTranslations } from "@/lib/utils/i18nUtils";
const t = await useTranslations(Astro.currentLocale as string);

const { code } = Astro.params;

const product_docs = await payload.find({
  collection: "products",
  depth: 2,
  pagination: false,
  limit: 1,
  where: { code: { equals: code } },
});

if (!product_docs) {
  return Astro.redirect("/404");
}

const product = product_docs.docs[0];
const variants_count = product.variants?.length ?? 0;

const product_images: Media[] = product.images as Media[];
---

<Base hideOffcanvas={true}>
  <section class="">
    <div class="container">
      <!-- TODO: responsive -->
      <div class="grid gap-2 sm:grid-cols-12 sm:gap-4 sm:px-2">
        <!-- nume+ -->
        <div class="space-y-4 sm:col-span-6">
          <div class="my-6">
            <h1
              class:list={[
                "leading-tight font-medium tracking-tight text-balance",
              ]}>
              {product.name}
            </h1>
          </div>
          <!-- partner -->
          <div class="flex flex-wrap gap-2">
            <Pill size="lg" partner={product.partner as Partner} />
            <a href={product.url} target="_blank">
              <Icons icon="ArrowUpRight" class="size-10 text-gray-400" />
            </a>
          </div>
          <div class="text-xl font-medium">
            <div set:html={product.description} />
          </div>
          <!-- categories and materials -->
          <div class="flex flex-wrap gap-2">
            <Pill category={product.category as Category} />
            {
              product.materials &&
                product.materials.map((material) => (
                  <Pill material={material as Material} />
                ))
            }
          </div>
          <!-- variants -->
          <div class="">
            {
              variants_count > 0 && (
                <ProductVariants product={product as Product} />
              )
            }
          </div>
          <!-- cta button -->
          <div class="mt-8 flex items-center">
            <a
              href="/contact?x=y"
              class="bg-accent px-4 py-2 text-white hover:text-black">
              {t("common.call")}
              <Icons
                icon="MessagesSquare"
                class="ml-2 inline-block size-6 stroke-white"
              />
            </a>
          </div>
        </div>
        <div class="space-y-2 p-2 sm:col-span-6">
          <!-- main image -->
          <Image
            src={(product.main_image! as Media).url!}
            alt={product.name}
            inferSize={true}
            width={300}
            height={300}
            class:list={[
              "w-full object-cover",
              // "transition-transform duration-700 ease-in-out group-hover:scale-105",
            ]}
          />
          <!-- gallery -->
          {
            product_images.length > 0 && (
              <ProductGallery images={product_images} />
            )
          }
        </div>
      </div>
    </div>
  </section>
</Base>
