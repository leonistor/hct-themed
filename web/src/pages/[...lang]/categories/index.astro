---
export const prerender = false;

import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import type { Media } from "shared";
import PageTitle from "@/layouts/components/ui/PageTitle.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";
import CategoryCard from "@/components/cards/CategoryCard.astro";

const payload = await getPayload({ config: payloadConfig });

const categories = await payload.find({
  collection: "categories",
  depth: 2,
  pagination: false,
  limit: 100,
  sort: "_order",
});

const t = await useTranslations(Astro.currentLocale as string);

const page = await getEntryCTM("categories", "-index", Astro.currentLocale);
---

<Base {...page?.data} hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <PageTitle title={t("categories.title")} />
      <div class="pb-8 md:text-xl">{t("categories.tagline")}</div>
      <div
        class="grid grid-cols-1 gap-x-4 gap-y-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
        {
          categories.docs.map((category, index) => (
            <CategoryCard index={index} category={category} />
          ))
        }
      </div>
    </div>
  </section>
</Base>
