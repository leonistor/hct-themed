---
export const prerender = false;

import Base from "@/layouts/Base.astro";
import PageTitle from "@/layouts/components/ui/PageTitle.astro";
import ProductsGrid from "@/layouts/components/ui/ProductsGrid.astro";

import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import type { Media } from "shared";
const payload = await getPayload({ config: payloadConfig });

const { code } = Astro.params;

const category_docs = await payload.find({
  collection: "categories",
  pagination: false,
  limit: 1,
  where: { code: { equals: code } },
});

if (!category_docs.docs) {
  return Astro.redirect("/404");
}

const category = category_docs.docs[0];
---

<Base hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <PageTitle title={category.name} />
      <div class="pb-4 md:text-xl">{category.description}</div>
      <ProductsGrid category_code={category.code} />
    </div>
  </section>
</Base>
