---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import { getPayload } from "payload";
import { config, type Media } from "admin";

const payload = await getPayload({ config });

const partners = await payload.find({
  collection: "partners",
  depth: 2,
  where: { published: { equals: true } },
});

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("about-us", "-index", Astro.currentLocale);
---

<Base {...page?.data} hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <div
        class=""
        class:list={[
          "mx-auto flex max-w-5xl flex-col items-center text-center",
        ]}>
        <h1
          data-aos="reveal-anim-top"
          data-aos-offset="0"
          data-aos-duration="600"
          class:list={["text-h1-sm md:text-h1"]}>
          Demo page
        </h1>

        <hr />
      </div>

      <div class="container">
        <div
          class="grid grid-cols-1 gap-x-4 gap-y-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
          {
            partners.docs.map((partner) => (
              <div class="col-span-1">
                <h2>{partner.name}</h2>
                <img
                  src={`http://localhost:3000${(partner.logo! as Media).url}`}
                  alt={partner.name}
                />
                <p>{partner.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>
