---
export const prerender = false;

import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import MaterialCard from "@/layouts/components/cards/MaterialCard.astro";
import PageTitle from "@/layouts/components/ui/PageTitle.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";

const payload = await getPayload({ config: payloadConfig });

const materials = await payload.find({
  collection: "materials",
  depth: 2,
  pagination: false,
  limit: 100,
  sort: "_order",
});

const t = await useTranslations(Astro.currentLocale as string);

const page = await getEntryCTM("solutions", "-index", Astro.currentLocale);
---

<Base {...page?.data} hideOffcanvas={true}>
  <section class="relative">
    <div class="container">
      <PageTitle title={t("solutions.title")} />
      <div class="pb-8 md:text-xl">{t("solutions.tagline")}</div>
      <div
        class="grid grid-cols-1 gap-x-4 gap-y-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
        {
          materials.docs.map((material, index) => (
            <MaterialCard index={index} material={material} />
          ))
        }
      </div>
    </div>
  </section>
</Base>
