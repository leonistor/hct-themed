---
import Sheet from "@/components/bearnie/sheet/Sheet.astro";
import SheetContent from "@/components/bearnie/sheet/SheetContent.astro";
import SheetHeader from "@/components/bearnie/sheet/SheetHeader.astro";
import SheetTitle from "@/components/bearnie/sheet/SheetTitle.astro";
import SheetFooter from "@/components/bearnie/sheet/SheetFooter.astro";
import SheetClose from "@/components/bearnie/sheet/SheetClose.astro";
import SheetOverlay from "@/components/bearnie/sheet/SheetOverlay.astro";
import SheetTrigger from "@/components/bearnie/sheet/SheetTrigger.astro";
import Input from "@/components/bearnie/input/Input.astro";
import Textarea from "@/components/bearnie/textarea/Textarea.astro";
import Button from "@/components/bearnie/button/Button.astro";
import Label from "@/components/bearnie/label/Label.astro";
import Checkbox from "@/components/bearnie/checkbox/Checkbox.astro";
import Select from "@/components/bearnie/select/Select.astro";
import SelectOption from "@/components/bearnie/select/SelectOption.astro";
import PayloadImage from "@/layouts/components/utilities/PayloadImage.astro";
import HugeIcon from "@/components/bearnie/fundations/icons/HugeIcon.astro";
import {
  ArrowUpRight01Icon,
  PlusSignIcon,
} from "@/components/bearnie/lib/hugeicons";
import Accordion from "@/components/bearnie/accordion/Accordion.astro";
import AccordionItem from "@/components/bearnie/accordion/AccordionItem.astro";
import AccordionTrigger from "@/components/bearnie/accordion/AccordionTrigger.astro";
import AccordionContent from "@/components/bearnie/accordion/AccordionContent.astro";

export interface VariantView {
  name?: string;
  feature?: string;
  description?: string;
  url?: string;
}

export interface ProductView {
  id: string;
  title: string;
  code?: string;
  name?: string;
  description?: string;
  url?: string;
  published?: boolean;
  promoted?: boolean;
  mainImageFilename?: string;
  categoryId: string;
  materialIds: Set<string>;
  variants: VariantView[];
}

export interface Props {
  product?: ProductView;
  categories?: { id: number | string; name: string }[];
  materials?: { id: number | string; name: string }[];
}

const {
  product = {
    id: "",
    title: "Edit Product",
    code: "",
    categoryId: "",
    materialIds: new Set<string>(),
    variants: [],
  },
  categories = [],
  materials = [],
} = Astro.props;
---

<Sheet>
  <SheetOverlay />
  <SheetTrigger id="sheet-open-trigger" class="hidden" />
  <template id="sheet-link-icon">
    <HugeIcon icon={ArrowUpRight01Icon} class="size-4 shrink-0" />
  </template>
  <SheetContent side="right" class="flex w-2/3 flex-col sm:max-w-2xl">
    <SheetHeader>
      <SheetTitle id="edit-sheet-title">{product.title}</SheetTitle>
    </SheetHeader>
    <form id="product-edit-form" class="flex-1 space-y-4 overflow-y-auto py-2">
      <input type="hidden" name="edit_id" value={product.id} />
      <div class="bg-muted/50 border-border rounded border p-2">
        <div class="space-y-2">
          <div class="space-y-2">
            <Label for="edit-name">Name</Label>
            <Input
              id="edit-name"
              name="edit_name"
              value={String(product.name ?? "")}
              required
            />
          </div>
          <div class="space-y-2">
            <Label>Main image</Label>
            <div data-edit-main-image>
              {
                product.mainImageFilename ? (
                  <PayloadImage
                    src={`/payload/products/${product.mainImageFilename}`}
                    alt={product.name ?? ""}
                    width={128}
                    height={128}
                    class="h-auto w-32 rounded object-cover"
                  />
                ) : (
                  <span class="text-muted-foreground/50 text-sm">—</span>
                )
              }
            </div>
          </div>
        </div>
        <div class="mt-2 space-y-2">
          <Label for="edit-description">Description</Label>
          <Textarea
            id="edit-description"
            name="edit_description"
            value={String(product.description ?? "")}
            rows={5}
          />
        </div>
        <div class="mt-2 flex items-center justify-between gap-6">
          <div class="flex items-center gap-3">
            <Checkbox
              id="edit-published"
              name="edit_published"
              checked={product.published ?? false}
            />
            <Label for="edit-published">Published</Label>
          </div>
          <div class="flex items-center gap-3">
            <Checkbox
              id="edit-promoted"
              name="edit_promoted"
              checked={product.promoted ?? false}
            />
            <Label for="edit-promoted">Promoted</Label>
          </div>
          <div class="flex items-center gap-1">
            <Label class="text-muted-foreground text-sm font-normal">URL</Label>
            <p data-edit-url class="flex items-center">
              {
                product.url ? (
                  <a
                    href={product.url}
                    target="_blank"
                    rel="noopener"
                    title={product.url}
                    class="text-primary inline-flex items-center">
                    <HugeIcon
                      icon={ArrowUpRight01Icon}
                      class="size-4 shrink-0"
                    />
                  </a>
                ) : (
                  <span class="text-muted-foreground/50">—</span>
                )
              }
            </p>
          </div>
        </div>
      </div>
      <!-- </div> -->
      <Accordion type="single" class="w-full">
        <AccordionItem value="category-materials">
          <AccordionTrigger
            icon={PlusSignIcon}
            iconSize="sm"
            class="text-sm font-semibold">
            Category &amp; Materials
          </AccordionTrigger>
          <AccordionContent>
            <div class="space-y-4">
              <div class="space-y-2">
                <Label for="edit-category">Category</Label>
                <Select id="edit-category" name="edit_category" class="w-full">
                  <SelectOption value="">—</SelectOption>
                  {
                    categories.map((c) => (
                      <SelectOption
                        value={String(c.id)}
                        selected={String(c.id) === product.categoryId}>
                        {c.name}
                      </SelectOption>
                    ))
                  }
                </Select>
              </div>
              <div class="space-y-2">
                <Label>Materials</Label>
                <div data-edit-materials class="space-y-2">
                  {
                    materials.map((m) => (
                      <div class="flex items-center gap-3">
                        <Checkbox
                          id={`edit-material-${m.id}`}
                          name="edit_materials"
                          value={String(m.id)}
                          checked={product.materialIds.has(String(m.id))}
                        />
                        <Label for={`edit-material-${m.id}`}>{m.name}</Label>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </AccordionContent>
        </AccordionItem>
        <AccordionItem value="variants">
          <AccordionTrigger
            id="edit-variants-title"
            icon={PlusSignIcon}
            iconSize="sm"
            class="text-sm font-semibold">
            {
              product.variants.length > 0
                ? `${product.variants.length} Variants`
                : "No Variants"
            }
          </AccordionTrigger>
          <AccordionContent>
            <div data-edit-variants class="space-y-2">
              {
                product.variants.length > 0 ? (
                  product.variants.map((v) => (
                    <div class="border-border flex items-center justify-between gap-2 rounded border p-3 text-sm">
                      <p class="whitespace-pre-wrap">
                        <span class="font-medium">{v.name}</span>
                        {(v.feature || v.description) && (
                          <span class="text-muted-foreground">
                            {`: ${v.feature ?? ""} ${v.description ?? ""}`.trimEnd()}
                          </span>
                        )}
                      </p>
                      {v.url && (
                        <a
                          href={v.url}
                          target="_blank"
                          rel="noopener"
                          title={v.url}
                          class="text-primary inline-flex shrink-0 items-center">
                          <HugeIcon
                            icon={ArrowUpRight01Icon}
                            class="size-4 shrink-0"
                          />
                        </a>
                      )}
                    </div>
                  ))
                ) : (
                  <p class="text-muted-foreground/50 text-sm">—</p>
                )
              }
            </div>
          </AccordionContent>
        </AccordionItem>
      </Accordion>
      <SheetFooter class="gap-2">
        <Button type="submit">Save</Button>
        <Button
          type="button"
          variant="link"
          data-edit-preview
          href={`/product/${product.code ?? ""}`}
          >Preview</Button
        >
        <SheetClose>Cancel</SheetClose>
      </SheetFooter>
    </form>
  </SheetContent>
</Sheet>
