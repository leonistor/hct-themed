---
export interface Props {
  makeUrl: (params: Record<string, string>) => string;
  page?: number;
  totalPages?: number;
  showPagination?: boolean;
  showPrev?: boolean;
  showNext?: boolean;
  isCurrentPage: (n: number) => boolean;
}

const {
  makeUrl,
  page = 1,
  totalPages = 1,
  showPagination = true,
  showPrev = false,
  showNext = false,
  isCurrentPage,
} = Astro.props;
---

<div class="flex items-center justify-end px-2 pt-4">
  {
    showPagination && (
      <nav aria-label="Pagination">
        <div class="flex items-center gap-1">
          {showPrev && (
            <a
              class="rounded-md border px-3 py-2 text-sm"
              href={makeUrl({ page: String(page - 1) })}>
              Previous
            </a>
          )}
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <a
              class:list={[
                "rounded-md border px-3 py-2 text-sm",
                isCurrentPage(n) && "bg-accent",
              ]}
              href={makeUrl({ page: String(n) })}
              aria-current={isCurrentPage(n) ? "page" : undefined}>
              {n}
            </a>
          ))}
          {showNext && (
            <a
              class="rounded-md border px-3 py-2 text-sm"
              href={makeUrl({ page: String(page + 1) })}>
              Next
            </a>
          )}
        </div>
      </nav>
    )
  }
</div>
