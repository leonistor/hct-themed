---
export interface Props {
  partners?: { id: number | string; name: string }[];
  categories?: { id: number | string; name: string }[];
  materials?: { id: number | string; name: string }[];
  search?: string;
  filterPartner?: string;
  filterCategory?: string;
  filterMaterial?: string;
  filterPublished?: string;
  rawLimit?: string;
  sortParam?: string;
  hasActiveFilters?: boolean;
  totalDocs?: number;
}

const {
  partners = [],
  categories = [],
  materials = [],
  search = "",
  filterPartner = "",
  filterCategory = "",
  filterMaterial = "",
  filterPublished = "",
  rawLimit = "10",
  sortParam = "",
  hasActiveFilters = false,
  totalDocs = 0,
} = Astro.props;
---

<section class="card mb-6 p-4">
  <form
    method="get"
    action="/admin"
    class="mb-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-[2fr_repeat(4,minmax(0,1fr))_auto_auto] lg:items-end">
    <div class="field">
      <label for="search">Search</label>
      <input
        type="search"
        id="search"
        name="search"
        value={search}
        placeholder="Product name…"
        class="input w-full"
      />
    </div>

    <div class="field">
      <label for="partner">Partner</label>
      <select id="partner" name="partner" class="select w-full">
        <option value="">All partners</option>
        {
          partners.map((p) => (
            <option
              value={String(p.id)}
              selected={String(p.id) === filterPartner}>
              {p.name}
            </option>
          ))
        }
      </select>
    </div>

    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category" class="select w-full">
        <option value="">All categories</option>
        {
          categories.map((c) => (
            <option
              value={String(c.id)}
              selected={String(c.id) === filterCategory}>
              {c.name}
            </option>
          ))
        }
      </select>
    </div>

    <div class="field">
      <label for="material">Material</label>
      <select id="material" name="material" class="select w-full">
        <option value="">All materials</option>
        {
          materials.map((m) => (
            <option
              value={String(m.id)}
              selected={String(m.id) === filterMaterial}>
              {m.name}
            </option>
          ))
        }
      </select>
    </div>

    <div class="field">
      <label for="published">Published</label>
      <select id="published" name="published" class="select w-full">
        <option value="">Any</option><option
          value="true"
          selected={filterPublished === "true"}>
          Yes
        </option><option value="false" selected={filterPublished === "false"}>
          No
        </option>
      </select>
    </div>

    <input type="hidden" name="limit" value={rawLimit} />
    {sortParam && <input type="hidden" name="sort" value={sortParam} />}

    <button type="submit" class="btn">Apply</button>

    {
      hasActiveFilters && (
        <a href="/admin" class="btn" data-variant="outline">
          Clear
        </a>
      )
    }
  </form>

  <div class="flex flex-wrap items-center justify-between gap-3 border-t pt-3">
    <p class="text-muted-foreground text-sm">{totalDocs} products</p>
    <div class="flex items-center gap-2">
      <label for="per-page" class="text-muted-foreground text-sm">
        Per page
      </label>
      <select id="per-page" class="select w-20" data-per-page>
        <option value="10" selected={rawLimit === "10"}>10</option>
        <option value="50" selected={rawLimit === "50"}>50</option>
        <option value="all" selected={rawLimit === "all"}>All</option>
      </select>
    </div>
  </div>
</section>

<script>
  const perPage = document.querySelector(
    "[data-per-page]",
  ) as HTMLSelectElement;
  if (perPage) {
    perPage.addEventListener("change", () => {
      const url = new URL(window.location.href);
      url.searchParams.set("limit", perPage.value);
      url.searchParams.delete("page");
      window.location.href = url.pathname + url.search;
    });
  }
</script>
