---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/utils/cn";
import HctLogo from "@/assets/images/hct-logo-2026.svg";
import HugeIcon from "@/components/bearnie/fundations/icons/HugeIcon.astro";
import {
  PackageIcon,
  SquareRoundCornerIcon,
  UserMultiple02Icon,
  Settings01Icon,
  Logout01Icon,
} from "@/components/bearnie/lib/hugeicons";

import Sidebar from "@/components/bearnie/sidebar/Sidebar.astro";
import SidebarContent from "@/components/bearnie/sidebar/SidebarContent.astro";
import SidebarFooter from "@/components/bearnie/sidebar/SidebarFooter.astro";
import SidebarHeader from "@/components/bearnie/sidebar/SidebarHeader.astro";
import SidebarMenu from "@/components/bearnie/sidebar/SidebarMenu.astro";
import SidebarMenuItem from "@/components/bearnie/sidebar/SidebarMenuItem.astro";
import SidebarMenuButton from "@/components/bearnie/sidebar/SidebarMenuButton.astro";
import SidebarSeparator from "@/components/bearnie/sidebar/SidebarSeparator.astro";

export interface Props extends HTMLAttributes<"aside"> {
  currentPath?: string;
  userEmail?: string;
}

const { currentPath = "/admin", userEmail, class: className, ...props } = Astro.props;

const items: { label: string; href: string; icon: unknown; active: boolean }[] =
  [
    {
      label: "Products",
      href: "/admin",
      icon: PackageIcon,
      active: currentPath === "/admin",
    },
    {
      label: "Categories",
      href: "#",
      icon: SquareRoundCornerIcon,
      active: false,
    },
    {
      label: "Partners",
      href: "#",
      icon: UserMultiple02Icon,
      active: false,
    },
    {
      label: "Materials",
      href: "#",
      icon: Settings01Icon,
      active: false,
    },
  ];
---

<Sidebar id="admin-sidebar" class={cn("h-screen", className)} {...props}>
  <SidebarHeader>
    <div class="flex items-center gap-2 px-2 py-1">
      <HctLogo class="size-7.5" role="img" aria-label="HCT logo" />
      <span class="text-lg font-semibold">Admin</span>
    </div>
  </SidebarHeader>

  <SidebarSeparator />

  <SidebarContent>
    <SidebarMenu>
      {items.map((item) => (
        <SidebarMenuItem>
          <SidebarMenuButton
            href={item.href}
            isActive={item.active}
            class="gap-2">
            <HugeIcon icon={item.icon as never} class="size-4" />
            <span>{item.label}</span>
          </SidebarMenuButton>
        </SidebarMenuItem>
      ))}
    </SidebarMenu>
  </SidebarContent>

  {userEmail && (
    <SidebarFooter>
      <div class="flex flex-col items-stretch gap-1">
        <span class="truncate px-2 text-xs font-medium text-muted-foreground">
          {userEmail}
        </span>
        <button
          type="button"
          data-admin-logout
          class="inline-flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
          <HugeIcon icon={Logout01Icon as never} class="size-4" />
          <span>Logout</span>
        </button>
      </div>
    </SidebarFooter>
  )}
</Sidebar>

<script>
  document.querySelectorAll("[data-admin-logout]").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        await fetch("/api/users/logout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({}),
        });
      } catch {
        /* proceed to login regardless */
      }
      window.location.href = "/admin/login";
    });
  });
</script>
