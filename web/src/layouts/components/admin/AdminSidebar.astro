---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/utils/cn";
import HctLogo from "@/assets/images/hct-logo-2026.svg";
import Icon from "@/components/ui/basecoat/Icon.astro";
import {
  PackageIcon,
  SquareRoundCornerIcon,
  UserMultiple02Icon,
  Settings01Icon,
  Logout01Icon,
} from "@/components/ui/basecoat/hugeicons";

export interface Props extends HTMLAttributes<"aside"> {
  currentPath?: string;
  userEmail?: string;
}

const {
  currentPath = "/admin",
  userEmail,
  class: className,
  ...props
} = Astro.props;

const items: {
  label: string;
  href: string;
  icon: typeof PackageIcon;
  active: boolean;
}[] = [
  {
    label: "Products",
    href: "/admin",
    icon: PackageIcon,
    active: currentPath === "/admin",
  },
  /*
    {
      label: "Categories",
      href: "#",
      icon: SquareRoundCornerIcon,
      active: false,
    },
    {
      label: "Partners",
      href: "#",
      icon: UserMultiple02Icon,
      active: false,
    },
    {
      label: "Materials",
      href: "#",
      icon: Settings01Icon,
      active: false,
    },
     */
];
---

<aside
  id="admin-sidebar"
  class={cn("sidebar", className)}
  data-side="left"
  {...props}>
  <header class="flex items-center gap-2 px-4 py-4">
    <div class="flex items-center gap-2 px-2 py-1">
      <HctLogo class="size-7.5" role="img" aria-label="HCT logo" />
      <span class="text-lg font-semibold">Admin</span>
    </div>
  </header>

  <hr role="separator" />

  <nav aria-label="Admin navigation">
    <section>
      <div role="group" aria-label="Content">
        <ul>
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? "page" : undefined}
                  data-active={item.active ? "true" : undefined}>
                  <Icon icon={item.icon} class="size-4" />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </nav>

  {
    userEmail && (
      <footer>
        <div class="flex flex-col items-stretch gap-1">
          <span class="text-muted-foreground truncate px-2 text-xs font-medium">
            {userEmail}
          </span>
          <button
            type="button"
            data-admin-logout
            class="btn w-full justify-start"
            data-variant="ghost"
            data-size="sm">
            <Icon icon={Logout01Icon} class="size-4" />
            <span>Logout</span>
          </button>
        </div>
      </footer>
    )
  }
</aside>

<script>
  document.querySelectorAll("[data-admin-logout]").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        await fetch("/api/users/logout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({}),
        });
      } catch {
        /* proceed to login regardless */
      }
      window.location.href = "/admin/login";
    });
  });
</script>
