---
export const prerender = false;

import AdminProductsFilters from "./AdminProductsFilters.astro";
import AdminProductsGrid from "./AdminProductsGrid.astro";
import AdminProductsPagination from "./AdminProductsPagination.astro";
import AdminProductSheet, { type ProductView } from "./AdminProductSheet.astro";

import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import type { Category, Material, Partner } from "admin";
import type { Where } from "payload";
import {
  ArrowUpDownIcon,
  ArrowUp02Icon,
  ArrowDown02Icon,
} from "@/components/bearnie/lib/hugeicons";

export interface Props {
  partners?: { id: number | string; name: string }[];
  categories?: { id: number | string; name: string }[];
  materials?: { id: number | string; name: string }[];
}

const { partners = [], categories = [], materials = [] } = Astro.props;

const payload = await getPayload({ config: payloadConfig });

const currentUrl = Astro.url;

let page = Number(currentUrl.searchParams.get("page"));
const rawLimit = currentUrl.searchParams.get("limit") ?? "10";
page = Number.isFinite(page) && page > 0 ? page : 1;
const showPagination = rawLimit !== "all";
const limit = showPagination ? Number(rawLimit) || 10 : 0;

const search = currentUrl.searchParams.get("search") ?? "";
const filterPartner = currentUrl.searchParams.get("partner") ?? "";
const filterCategory = currentUrl.searchParams.get("category") ?? "";
const filterMaterial = currentUrl.searchParams.get("material") ?? "";
const filterPublished = currentUrl.searchParams.get("published") ?? "";

const sortParam = currentUrl.searchParams.get("sort") ?? "";
const SORTABLE_COLUMNS = ["published", "name", "partner", "category"] as const;
type SortableColumn = (typeof SORTABLE_COLUMNS)[number];
let sortField: SortableColumn | "" = "";
let sortDir: "asc" | "desc" = "asc";
if (sortParam) {
  const [field, dir] = sortParam.split("|");
  if (SORTABLE_COLUMNS.includes(field as SortableColumn)) {
    sortField = field as SortableColumn;
    sortDir = dir === "desc" ? "desc" : "asc";
  }
}
const sort = sortField
  ? `${sortDir === "desc" ? "-" : ""}${sortField === "partner" ? "partner.name" : sortField === "category" ? "category.name" : sortField}`
  : "_order";

const sortIcon = (field: string) =>
  sortField !== field
    ? ArrowUpDownIcon
    : sortDir === "asc"
      ? ArrowUp02Icon
      : ArrowDown02Icon;
const sortIconClass = (field: string) =>
  sortField === field ? "text-foreground" : "text-muted-foreground";

const where: Where = {};
const and: Where[] = [];

if (search) and.push({ name: { contains: search } });
if (filterPartner) and.push({ partner: { equals: filterPartner } });
if (filterCategory) and.push({ category: { equals: filterCategory } });
if (filterMaterial) and.push({ materials: { contains: filterMaterial } });
if (filterPublished)
  and.push({ published: { equals: filterPublished === "true" } });

if (and.length === 1) Object.assign(where, and[0]);
else if (and.length > 1) where.and = and;

const products = await payload.find({
  collection: "products",
  depth: 1,
  page,
  limit,
  sort,
  where,
  select: {
    folder: false,
    images: false,
  },
});

const totalPages = products.totalPages;
const totalDocs = products.totalDocs;

const makeUrl = (params: Record<string, string>) => {
  const url = new URL(currentUrl.toString());
  for (const [key, value] of Object.entries(params)) {
    if (value) url.searchParams.set(key, value);
    else url.searchParams.delete(key);
  }
  return url.pathname + url.search;
};

const sortHref = (field: string) =>
  makeUrl({
    sort:
      sortField === field && sortDir === "asc"
        ? `${field}|desc`
        : sortField === field
          ? ""
          : `${field}|asc`,
    page: "1",
  });

const isCurrentPage = (n: number) => showPagination && n === page;

const showPrev = showPagination && products.hasPrevPage;
const showNext = showPagination && products.hasNextPage;

const hasActiveFilters = Boolean(
  search ||
  filterPartner ||
  filterCategory ||
  filterMaterial ||
  filterPublished ||
  sortParam,
);

const editId = currentUrl.searchParams.get("edit") ?? "";
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let activeProduct: any = null;
if (editId) {
  try {
    activeProduct = await payload.findByID({
      collection: "products",
      id: editId,
      depth: 2,
    });
  } catch {
    activeProduct = null;
  }
}

const activeMainImage = activeProduct?.main_image as
  | { sizes?: { medium?: { filename?: string } } }
  | null
  | undefined;

const activeCategoryId = activeProduct?.category
  ? String(
      typeof activeProduct.category === "object"
        ? activeProduct.category.id
        : activeProduct.category,
    )
  : "";

const activeMaterialIds = new Set<string>(
  (activeProduct?.materials ?? []).map((m: unknown) => {
    if (typeof m === "object" && m && "id" in m)
      return String((m as { id: number | string }).id);
    return String(m as number | string);
  }),
);

const activeVariants = (activeProduct?.variants ?? []) as {
  name?: string;
  feature?: string;
  description?: string;
  url?: string;
}[];

const activeProductTitle =
  activeProduct &&
  typeof activeProduct.partner === "object" &&
  activeProduct.partner
    ? `${activeProduct.partner.name}: ${activeProduct.name}`
    : (activeProduct?.name ?? "Edit Product");

const activeProductView: ProductView = {
  id: activeProduct ? String(activeProduct.id) : "",
  title: activeProductTitle,
  code: activeProduct?.code,
  name: activeProduct?.name,
  description: activeProduct?.description,
  url: activeProduct?.url,
  published: activeProduct?.published ?? false,
  promoted: activeProduct?.promoted ?? false,
  mainImageFilename: activeMainImage?.sizes?.medium?.filename,
  categoryId: activeCategoryId,
  materialIds: activeMaterialIds,
  variants: activeVariants,
};
---

<AdminProductsFilters
  partners={partners}
  categories={categories}
  materials={materials}
  search={search}
  filterPartner={filterPartner}
  filterCategory={filterCategory}
  filterMaterial={filterMaterial}
  filterPublished={filterPublished}
  rawLimit={rawLimit}
  sortParam={sortParam}
  hasActiveFilters={hasActiveFilters}
  totalDocs={totalDocs}
/>
<AdminProductsGrid
  products={products.docs}
  editId={editId}
  sortHref={sortHref}
  sortIcon={sortIcon}
  sortIconClass={sortIconClass}
/>
<AdminProductsPagination
  makeUrl={makeUrl}
  page={page}
  totalPages={totalPages}
  showPagination={showPagination}
  showPrev={showPrev}
  showNext={showNext}
  isCurrentPage={isCurrentPage}
/>
<AdminProductSheet
  product={activeProductView}
  categories={categories}
  materials={materials}
/>

<script>
  function buildUrl(editId?: string) {
    const url = new URL(window.location.href);
    if (editId) url.searchParams.set("edit", editId);
    else url.searchParams.delete("edit");
    return url.pathname + url.search;
  }

  function getEditParam() {
    return new URLSearchParams(window.location.search).get("edit") ?? "";
  }

  function closeSheet() {
    const btn = document.querySelector(
      "[data-sheet-content] [data-sheet-close]",
    );
    if (btn) (btn as HTMLElement).click();
  }

  function openSheet() {
    const content = document.querySelector("[data-sheet-content]");
    if (content) content.classList.remove("hidden");
    const trigger = document.getElementById("sheet-open-trigger");
    if (trigger) trigger.click();
  }

  function relationId(value: unknown): string {
    return value && typeof value === "object"
      ? String((value as { id: number | string }).id)
      : String(value ?? "");
  }

  function externalUrlLink(url: string): HTMLAnchorElement {
    const a = document.createElement("a");
    a.href = url;
    a.target = "_blank";
    a.rel = "noopener";
    a.title = url;
    a.className = "inline-flex items-center text-primary";
    const tmpl = document.getElementById(
      "sheet-link-icon",
    ) as HTMLTemplateElement | null;
    if (tmpl) a.appendChild(tmpl.content.cloneNode(true));
    return a;
  }

  function populateForm(product: {
    id: string | number;
    name?: string;
    code?: string;
    description?: string;
    published?: boolean;
    promoted?: boolean;
    category?: unknown;
    materials?: unknown[];
    url?: string;
    variants?: {
      name?: string;
      feature?: string;
      description?: string;
      url?: string;
    }[];
    main_image?: {
      url?: string;
      sizes?: {
        medium?: { url?: string; filename?: string };
      };
    } | null;
    partner?: unknown;
  }) {
    const f = document.getElementById("product-edit-form") as HTMLFormElement;
    if (!f) return;
    (f.querySelector("[name=edit_id]") as HTMLInputElement).value = String(
      product.id,
    );
    (f.querySelector("[name=edit_name]") as HTMLInputElement).value = String(
      product.name ?? "",
    );
    const titleEl = document.getElementById("edit-sheet-title");
    if (titleEl) {
      const partner = product.partner as { name?: string } | null | undefined;
      titleEl.textContent = partner?.name
        ? `${partner.name}: ${product.name ?? ""}`
        : product.name || "Edit Product";
    }
    (f.querySelector("[name=edit_description]") as HTMLTextAreaElement).value =
      String(product.description ?? "");
    (f.querySelector("[name=edit_published]") as HTMLInputElement).checked =
      !!product.published;
    (f.querySelector("[name=edit_promoted]") as HTMLInputElement).checked =
      !!product.promoted;

    const previewLink = f.querySelector(
      "[data-edit-preview]",
    ) as HTMLAnchorElement | null;
    if (previewLink) {
      previewLink.href = `/product/${product.code ?? ""}`;
      previewLink.onclick = (e: MouseEvent) => {
        e.preventDefault();
        window.open(previewLink.href, "product-preview");
      };
    }

    const categorySelect = f.querySelector(
      "[name=edit_category]",
    ) as HTMLSelectElement;
    if (categorySelect) categorySelect.value = relationId(product.category);

    const materialCheckboxes = f.querySelectorAll(
      "[data-edit-materials] input[name=edit_materials]",
    );
    const selectedMaterials = new Set(
      (product.materials ?? []).map((m) => relationId(m)),
    );
    materialCheckboxes.forEach((box) => {
      (box as HTMLInputElement).checked = selectedMaterials.has(
        (box as HTMLInputElement).value,
      );
    });

    const urlEl = f.querySelector("[data-edit-url]");
    if (urlEl) {
      urlEl.textContent = "";
      if (product.url) {
        urlEl.appendChild(externalUrlLink(product.url));
      } else {
        const span = document.createElement("span");
        span.className = "text-muted-foreground/50";
        span.textContent = "—";
        urlEl.appendChild(span);
      }
    }

    const variantsEl = f.querySelector("[data-edit-variants]");
    if (variantsEl) {
      variantsEl.textContent = "";
      const variants = product.variants ?? [];
      const variantsTitle = document.getElementById("edit-variants-title");
      if (variantsTitle) {
        variantsTitle.textContent =
          variants.length > 0 ? `${variants.length} Variants` : "No Variants";
      }
      if (variants.length === 0) {
        variantsEl.textContent = "—";
      } else {
        variants.forEach((v) => {
          const box = document.createElement("div");
          box.className =
            "flex items-center justify-between gap-2 rounded-lg border border-border p-3 text-sm";
          const text = document.createElement("p");
          text.className = "whitespace-pre-wrap";
          const name = document.createElement("span");
          name.className = "font-medium";
          name.textContent = v.name ?? "";
          text.appendChild(name);
          if (v.feature || v.description) {
            const rest = document.createElement("span");
            rest.className = "text-muted-foreground";
            rest.textContent =
              `: ${v.feature ?? ""} ${v.description ?? ""}`.trimEnd();
            text.appendChild(rest);
          }
          box.appendChild(text);
          if (v.url) {
            box.appendChild(externalUrlLink(v.url));
          }
          variantsEl.appendChild(box);
        });
      }
    }

    const imgEl = f.querySelector("[data-edit-main-image]");
    if (imgEl) {
      imgEl.textContent = "";
      const url =
        product.main_image?.sizes?.medium?.url ?? product.main_image?.url;
      if (url) {
        const img = document.createElement("img");
        img.src = url;
        img.alt = product.name ?? "";
        img.width = 128;
        img.height = 128;
        img.className = "h-auto w-32 rounded object-cover";
        imgEl.appendChild(img);
      } else {
        const span = document.createElement("span");
        span.className = "text-muted-foreground/50 text-sm";
        span.textContent = "—";
        imgEl.appendChild(span);
      }
    }
  }

  function updateRow(
    id: string,
    data: {
      name?: string;
      published?: boolean;
      category?: { id: number | string; name?: string } | number | string;
      materials?: ({ id: number | string; name?: string } | number | string)[];
    },
  ) {
    const row = document.querySelector(`[data-product-id="${id}"]`);
    if (!row) return;
    const cells = row.querySelectorAll("td");
    if (data.published !== undefined && cells[1]) {
      const box = cells[1].querySelector("input[type=checkbox]");
      if (box) (box as HTMLInputElement).checked = !!data.published;
    }
    if (data.name !== undefined && cells[2]) cells[2].textContent = data.name;
    if (data.category !== undefined && cells[5]) {
      const name =
        data.category && typeof data.category === "object"
          ? data.category.name
          : undefined;
      cells[5].textContent = name ?? "—";
    }
    if (data.materials !== undefined && cells[6]) {
      cells[6].textContent =
        data.materials
          .map((m) => (typeof m === "object" ? m.name : undefined))
          .filter(Boolean)
          .join(", ") || "—";
    }
  }

  async function openEditSheet(id: string) {
    try {
      const res = await fetch(`/api/products/${id}`);
      if (!res.ok) return;
      const product = await res.json();
      populateForm(product);
      openSheet();
    } catch {
      /* silent */
    }
  }

  function removeEditFromUrl() {
    if (getEditParam()) {
      history.replaceState({}, "", buildUrl());
    }
  }

  // Row click → open edit sheet without page reload
  document.querySelectorAll("[data-product-id]").forEach((row) => {
    row.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a, button, input, select")) return;
      const id = row.getAttribute("data-product-id");
      if (!id) return;
      history.pushState({ editId: id }, "", buildUrl(id));
      openEditSheet(id);
    });
  });

  // Save form
  const form = document.getElementById("product-edit-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const id = (form.querySelector("[name=edit_id]") as HTMLInputElement)
        .value;
      const materialInputs = Array.from(
        form.querySelectorAll(
          "[data-edit-materials] input[name=edit_materials]",
        ),
      ) as HTMLInputElement[];
      const materialIds = materialInputs
        .filter((box) => box.checked)
        .map((box) => box.value);
      const data = {
        name: (form.querySelector("[name=edit_name]") as HTMLInputElement)
          .value,
        description: (
          form.querySelector("[name=edit_description]") as HTMLTextAreaElement
        ).value,
        published: (
          form.querySelector("[name=edit_published]") as HTMLInputElement
        ).checked,
        promoted: (
          form.querySelector("[name=edit_promoted]") as HTMLInputElement
        ).checked,
        category:
          (form.querySelector("[name=edit_category]") as HTMLSelectElement)
            .value || null,
        materials: materialIds,
      };

      const res = await fetch(`/api/products/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        const updated = await res.json();
        history.replaceState({}, "", buildUrl());
        closeSheet();
        updateRow(id, updated);
      }
    });
  }

  // Close sheet buttons → remove edit param from URL
  document.querySelectorAll("[data-sheet-close]").forEach((btn) => {
    btn.addEventListener("click", removeEditFromUrl);
  });

  // Overlay click → remove edit param from URL
  const overlay = document.querySelector("[data-sheet-overlay]");
  if (overlay) {
    overlay.addEventListener("click", removeEditFromUrl);
  }

  // Escape key → remove edit param from URL
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") removeEditFromUrl();
  });

  // Browser back/forward
  window.addEventListener("popstate", () => {
    const editId = getEditParam();
    if (editId) openEditSheet(editId);
    else {
      const content = document.querySelector(
        "[data-sheet-content]",
      ) as HTMLElement;
      if (content && !content.hidden) closeSheet();
    }
  });

  // Auto-open sheet on initial page load when edit param is present
  const initialEditId = getEditParam();
  if (initialEditId) {
    const trigger = document.getElementById("sheet-open-trigger");
    if (trigger) {
      setTimeout(() => trigger.click(), 50);
    }
  }
</script>
