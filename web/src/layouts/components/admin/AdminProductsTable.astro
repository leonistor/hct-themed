---
export const prerender = false;

import Pagination from "@/components/bearnie/pagination/Pagination.astro";
import PaginationContent from "@/components/bearnie/pagination/PaginationContent.astro";
import PaginationItem from "@/components/bearnie/pagination/PaginationItem.astro";
import PaginationLink from "@/components/bearnie/pagination/PaginationLink.astro";
import PaginationPrevious from "@/components/bearnie/pagination/PaginationPrevious.astro";
import PaginationNext from "@/components/bearnie/pagination/PaginationNext.astro";
import Table from "@/components/bearnie/table/Table.astro";
import TableHeader from "@/components/bearnie/table/TableHeader.astro";
import TableBody from "@/components/bearnie/table/TableBody.astro";
import TableRow from "@/components/bearnie/table/TableRow.astro";
import TableHead from "@/components/bearnie/table/TableHead.astro";
import TableCell from "@/components/bearnie/table/TableCell.astro";
import Checkbox from "@/components/bearnie/checkbox/Checkbox.astro";
import PayloadImage from "@/layouts/components/utilities/PayloadImage.astro";
import Select from "@/components/bearnie/select/Select.astro";
import SelectOption from "@/components/bearnie/select/SelectOption.astro";
import HugeIcon from "@/components/bearnie/fundations/icons/HugeIcon.astro";
import {
  ArrowUpDownIcon,
  ArrowUp02Icon,
  ArrowDown02Icon,
  CheckmarkCircle01Icon,
  Layers01Icon,
} from "@/components/bearnie/lib/hugeicons";
import Sheet from "@/components/bearnie/sheet/Sheet.astro";
import SheetContent from "@/components/bearnie/sheet/SheetContent.astro";
import SheetHeader from "@/components/bearnie/sheet/SheetHeader.astro";
import SheetTitle from "@/components/bearnie/sheet/SheetTitle.astro";
import SheetFooter from "@/components/bearnie/sheet/SheetFooter.astro";
import SheetClose from "@/components/bearnie/sheet/SheetClose.astro";
import SheetOverlay from "@/components/bearnie/sheet/SheetOverlay.astro";
import SheetTrigger from "@/components/bearnie/sheet/SheetTrigger.astro";
import Input from "@/components/bearnie/input/Input.astro";
import Textarea from "@/components/bearnie/textarea/Textarea.astro";
import Button from "@/components/bearnie/button/Button.astro";
import Label from "@/components/bearnie/label/Label.astro";

import { getPayload } from "payload";
import { config as payloadConfig } from "admin";
import type { Category, Material, Partner } from "admin";
import type { Where } from "payload";

export interface Props {
  partners?: { id: number | string; name: string }[];
  categories?: { id: number | string; name: string }[];
  materials?: { id: number | string; name: string }[];
}

const { partners = [], categories = [], materials = [] } = Astro.props;

const payload = await getPayload({ config: payloadConfig });

const currentUrl = Astro.url;

let page = Number(currentUrl.searchParams.get("page"));
const rawLimit = currentUrl.searchParams.get("limit") ?? "10";
page = Number.isFinite(page) && page > 0 ? page : 1;
const showPagination = rawLimit !== "all";
const limit = showPagination ? Number(rawLimit) || 10 : 0;

const search = currentUrl.searchParams.get("search") ?? "";
const filterPartner = currentUrl.searchParams.get("partner") ?? "";
const filterCategory = currentUrl.searchParams.get("category") ?? "";
const filterMaterial = currentUrl.searchParams.get("material") ?? "";
const filterPublished = currentUrl.searchParams.get("published") ?? "";

const sortParam = currentUrl.searchParams.get("sort") ?? "";
const SORTABLE_COLUMNS = [
  "code",
  "published",
  "name",
  "partner",
  "category",
] as const;
type SortableColumn = (typeof SORTABLE_COLUMNS)[number];
let sortField: SortableColumn | "" = "";
let sortDir: "asc" | "desc" = "asc";
if (sortParam) {
  const [field, dir] = sortParam.split("|");
  if (SORTABLE_COLUMNS.includes(field as SortableColumn)) {
    sortField = field as SortableColumn;
    sortDir = dir === "desc" ? "desc" : "asc";
  }
}
const sort = sortField
  ? `${sortDir === "desc" ? "-" : ""}${sortField === "partner" ? "partner.name" : sortField === "category" ? "category.name" : sortField}`
  : "_order";

const sortIcon = (field: SortableColumn) =>
  sortField !== field
    ? ArrowUpDownIcon
    : sortDir === "asc"
      ? ArrowUp02Icon
      : ArrowDown02Icon;
const sortIconClass = (field: SortableColumn) =>
  sortField === field ? "text-foreground" : "text-muted-foreground";

const where: Where = {};
const and: Where[] = [];

if (search) and.push({ name: { contains: search } });
if (filterPartner) and.push({ partner: { equals: filterPartner } });
if (filterCategory) and.push({ category: { equals: filterCategory } });
if (filterMaterial) and.push({ materials: { contains: filterMaterial } });
if (filterPublished)
  and.push({ published: { equals: filterPublished === "true" } });

if (and.length === 1) Object.assign(where, and[0]);
else if (and.length > 1) where.and = and;

const products = await payload.find({
  collection: "products",
  depth: 1,
  page,
  limit,
  sort,
  where,
  select: {
    folder: false,
    images: false,
  },
});

const totalPages = products.totalPages;
const totalDocs = products.totalDocs;

const makeUrl = (params: Record<string, string>) => {
  const url = new URL(currentUrl.toString());
  for (const [key, value] of Object.entries(params)) {
    if (value) url.searchParams.set(key, value);
    else url.searchParams.delete(key);
  }
  return url.pathname + url.search;
};

const isCurrentPage = (n: number) => showPagination && n === page;

const showPrev = showPagination && products.hasPrevPage;
const showNext = showPagination && products.hasNextPage;

const hasActiveFilters =
  search ||
  filterPartner ||
  filterCategory ||
  filterMaterial ||
  filterPublished ||
  sortParam;

const editId = currentUrl.searchParams.get("edit") ?? "";
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let activeProduct: any = null;
if (editId) {
  try {
    activeProduct = await payload.findByID({
      collection: "products",
      id: editId,
      depth: 2,
    });
  } catch {
    activeProduct = null;
  }
}

const activeMainImage = activeProduct?.main_image as
  | { sizes?: { medium?: { filename?: string } } }
  | null
  | undefined;

const activeCategoryId = activeProduct?.category
  ? String(
      typeof activeProduct.category === "object"
        ? activeProduct.category.id
        : activeProduct.category,
    )
  : "";

const activeMaterialIds = new Set<string>(
  (activeProduct?.materials ?? []).map((m: unknown) => {
    if (typeof m === "object" && m && "id" in m)
      return String((m as { id: number | string }).id);
    return String(m as number | string);
  }),
);

const activeVariants = (activeProduct?.variants ?? []) as {
  name?: string;
  feature?: string;
  description?: string;
  url?: string;
}[];
---

<div class="bg-muted/50 mb-6 rounded-lg border p-4">
  <form
    method="get"
    action="/admin"
    class="mb-3 flex flex-wrap items-end gap-3">
    <div class="flex flex-col gap-1">
      <label for="search" class="text-muted-foreground text-xs font-medium">
        Search
      </label>
      <input
        type="search"
        id="search"
        name="search"
        value={search}
        placeholder="Product name…"
        class="border-input bg-background placeholder:text-muted-foreground focus:ring-ring h-10 w-48 rounded-lg border px-3 py-2 text-sm focus:ring-2 focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-1">
      <label for="partner" class="text-muted-foreground text-xs font-medium">
        Partner
      </label>
      <Select id="partner" name="partner" class="w-44">
        <SelectOption value="">All partners</SelectOption>
        {
          partners.map((p) => (
            <SelectOption
              value={String(p.id)}
              selected={String(p.id) === filterPartner}>
              {p.name}
            </SelectOption>
          ))
        }
      </Select>
    </div>

    <div class="flex flex-col gap-1">
      <label for="category" class="text-muted-foreground text-xs font-medium">
        Category
      </label>
      <Select id="category" name="category" class="w-44">
        <SelectOption value="">All categories</SelectOption>
        {
          categories.map((c) => (
            <SelectOption
              value={String(c.id)}
              selected={String(c.id) === filterCategory}>
              {c.name}
            </SelectOption>
          ))
        }
      </Select>
    </div>

    <div class="flex flex-col gap-1">
      <label for="material" class="text-muted-foreground text-xs font-medium">
        Material
      </label>
      <Select id="material" name="material" class="w-44">
        <SelectOption value="">All materials</SelectOption>
        {
          materials.map((m) => (
            <SelectOption
              value={String(m.id)}
              selected={String(m.id) === filterMaterial}>
              {m.name}
            </SelectOption>
          ))
        }
      </Select>
    </div>

    <div class="flex flex-col gap-1">
      <label for="published" class="text-muted-foreground text-xs font-medium">
        Published
      </label>
      <Select id="published" name="published" class="w-36">
        <SelectOption value="">Any</SelectOption>
        <SelectOption value="true" selected={filterPublished === "true"}
          >Yes</SelectOption
        >
        <SelectOption value="false" selected={filterPublished === "false"}
          >No</SelectOption
        >
      </Select>
    </div>

    <input type="hidden" name="limit" value={rawLimit} />
    {sortParam && <input type="hidden" name="sort" value={sortParam} />}

    <button
      type="submit"
      class="bg-primary text-primary-foreground hover:bg-primary/90 h-10 rounded-lg px-4 py-2 text-sm font-medium transition-colors">
      Apply
    </button>

    {
      hasActiveFilters && (
        <a
          href="/admin"
          class="border-input text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex h-10 items-center rounded-lg border px-4 py-2 text-sm font-medium transition-colors">
          Clear
        </a>
      )
    }
  </form>

  <div class="border-border flex items-center justify-between border-t pt-3">
    <p class="text-muted-foreground text-sm">{totalDocs} products</p>
    <div class="flex items-center gap-2">
      <label for="per-page" class="text-muted-foreground text-sm">
        Per page
      </label>
      <select
        id="per-page"
        class="border-input bg-background focus:ring-ring h-8 w-20 rounded-md border px-2 text-sm focus:ring-2 focus:outline-none"
        data-per-page>
        <option value="10" selected={rawLimit === "10"}>10</option>
        <option value="50" selected={rawLimit === "50"}>50</option>
        <option value="all" selected={rawLimit === "all"}>All</option>
      </select>
    </div>
  </div>
</div>

<Table>
  <TableHeader>
    <TableRow>
      <TableHead style="width: 12.5%">Image</TableHead>
      <TableHead style="width: 8.33%">
        <a
          href={makeUrl({
            sort:
              sortField === "code" && sortDir === "asc"
                ? "code|desc"
                : sortField === "code"
                  ? ""
                  : "code|asc",
            page: "1",
          })}
          class="flex items-center justify-between gap-1 hover:underline">
          <span>Code</span>
          <HugeIcon
            icon={sortIcon("code")}
            class:list={["size-3.5", sortIconClass("code")]}
          />
        </a>
      </TableHead>
      <TableHead style="width: 4.17%">
        <a
          href={makeUrl({
            sort:
              sortField === "published" && sortDir === "asc"
                ? "published|desc"
                : sortField === "published"
                  ? ""
                  : "published|asc",
            page: "1",
          })}
          class="flex items-center justify-between gap-1 hover:underline">
          <HugeIcon icon={CheckmarkCircle01Icon} class="size-4" />
          <HugeIcon
            icon={sortIcon("published")}
            class:list={["size-3.5", sortIconClass("published")]}
          />
        </a>
      </TableHead>
      <TableHead style="width: 20.83%">
        <a
          href={makeUrl({
            sort:
              sortField === "name" && sortDir === "asc"
                ? "name|desc"
                : sortField === "name"
                  ? ""
                  : "name|asc",
            page: "1",
          })}
          class="flex items-center justify-between gap-1 hover:underline">
          <span>Name</span>
          <HugeIcon
            icon={sortIcon("name")}
            class:list={["size-3.5", sortIconClass("name")]}
          />
        </a>
      </TableHead>
      <TableHead style="width: 4.17%">
        <HugeIcon icon={Layers01Icon} class="size-4" />
      </TableHead>
      <TableHead style="width: 8.33%">
        <a
          href={makeUrl({
            sort:
              sortField === "partner" && sortDir === "asc"
                ? "partner|desc"
                : sortField === "partner"
                  ? ""
                  : "partner|asc",
            page: "1",
          })}
          class="flex items-center justify-between gap-1 hover:underline">
          <span>Partner</span>
          <HugeIcon
            icon={sortIcon("partner")}
            class:list={["size-3.5", sortIconClass("partner")]}
          />
        </a>
      </TableHead>
      <TableHead style="width: 20.83%">
        <a
          href={makeUrl({
            sort:
              sortField === "category" && sortDir === "asc"
                ? "category|desc"
                : sortField === "category"
                  ? ""
                  : "category|asc",
            page: "1",
          })}
          class="flex items-center justify-between gap-1 hover:underline">
          <span>Category</span>
          <HugeIcon
            icon={sortIcon("category")}
            class:list={["size-3.5", sortIconClass("category")]}
          />
        </a>
      </TableHead>
      <TableHead style="width: 20.83%">Materials</TableHead>
    </TableRow>
  </TableHeader>
  <TableBody>
    {
      products.docs.map((product) => {
        const mainImage = product.main_image as unknown as {
          sizes?: { medium?: { filename?: string } };
        } | null;
        const mediumImage = mainImage?.sizes?.medium?.filename;
        const partner = product.partner;
        const category = product.category;
        const materials = (product.materials ?? []) as (Material | number)[];
        const variantsCount = product.variants?.length ?? 0;
        const isActive = String(product.id) === editId;

        return (
          <TableRow
            data-product-id={product.id}
            class:list={[
              "hover:bg-muted/50 cursor-pointer transition-colors",
              isActive && "bg-accent",
            ]}>
            <TableCell>
              {mediumImage ? (
                <PayloadImage
                  src={`/payload/products/${mediumImage}`}
                  alt={product.name}
                  width={48}
                  height={48}
                  class="h-auto w-full rounded object-cover"
                />
              ) : (
                <span class="text-muted-foreground">—</span>
              )}
            </TableCell>
            <TableCell class="text-muted-foreground font-medium">
              {product.code}
            </TableCell>
            <TableCell>
              <Checkbox checked={product.published ?? false} disabled />
            </TableCell>
            <TableCell class="font-medium">{product.name}</TableCell>
            <TableCell>{variantsCount > 0 ? variantsCount : "—"}</TableCell>
            <TableCell>
              {typeof partner === "object" && partner ? partner.name : "—"}
            </TableCell>
            <TableCell>
              {typeof category === "object" && category ? category.name : "—"}
            </TableCell>
            <TableCell>
              {materials
                .map((material) =>
                  typeof material === "object" && material
                    ? material.name
                    : "—",
                )
                .join(", ")}
            </TableCell>
          </TableRow>
        );
      })
    }
  </TableBody>
</Table>

<div class="flex items-center justify-end px-2 pt-4">
  {
    showPagination && (
      <Pagination>
        <PaginationContent>
          {showPrev && (
            <PaginationItem>
              <PaginationPrevious href={makeUrl({ page: String(page - 1) })} />
            </PaginationItem>
          )}
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <PaginationItem>
              <PaginationLink
                href={makeUrl({ page: String(n) })}
                isActive={isCurrentPage(n)}>
                {n}
              </PaginationLink>
            </PaginationItem>
          ))}
          {showNext && (
            <PaginationItem>
              <PaginationNext href={makeUrl({ page: String(page + 1) })} />
            </PaginationItem>
          )}
        </PaginationContent>
      </Pagination>
    )
  }
</div>

<Sheet>
  <SheetOverlay />
  <SheetTrigger id="sheet-open-trigger" class="hidden" />
  <SheetContent side="right" class="flex w-2/3 flex-col sm:max-w-2xl">
    <SheetHeader>
      <SheetTitle>Edit Product</SheetTitle>
    </SheetHeader>
    <form id="product-edit-form" class="flex-1 space-y-4 overflow-y-auto py-4">
      <input
        type="hidden"
        name="id"
        value={activeProduct ? String(activeProduct.id) : ""}
      />
      <div class="space-y-2">
        <Label for="edit-code">Code</Label>
        <Input
          id="edit-code"
          name="code"
          value={activeProduct ? String(activeProduct.code ?? "") : ""}
          required
        />
      </div>
      <div class="space-y-2">
        <Label for="edit-name">Name</Label>
        <Input
          id="edit-name"
          name="name"
          value={activeProduct ? String(activeProduct.name ?? "") : ""}
          required
        />
      </div>
      <div class="space-y-2">
        <Label for="edit-description">Description</Label>
        <Textarea
          id="edit-description"
          name="description"
          value={activeProduct ? String(activeProduct.description ?? "") : ""}
          rows={5}
        />
      </div>
      <div class="flex items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <Checkbox
            id="edit-published"
            name="published"
            checked={activeProduct?.published ?? false}
          />
          <Label for="edit-published">Published</Label>
        </div>
        <div class="flex items-center gap-3">
          <Checkbox
            id="edit-promoted"
            name="promoted"
            checked={activeProduct?.promoted ?? false}
          />
          <Label for="edit-promoted">Promoted</Label>
        </div>
      </div>
      <div class="space-y-2">
        <Label for="edit-category">Category</Label>
        <Select id="edit-category" name="category" class="w-full">
          <SelectOption value="">—</SelectOption>
          {
            categories.map((c) => (
              <SelectOption
                value={String(c.id)}
                selected={String(c.id) === activeCategoryId}>
                {c.name}
              </SelectOption>
            ))
          }
        </Select>
      </div>
      <div class="space-y-2">
        <Label>Materials</Label>
        <div data-edit-materials class="space-y-2">
          {
            materials.map((m) => (
              <div class="flex items-center gap-3">
                <Checkbox
                  id={`edit-material-${m.id}`}
                  name="materials"
                  value={String(m.id)}
                  checked={activeMaterialIds.has(String(m.id))}
                />
                <Label for={`edit-material-${m.id}`}>{m.name}</Label>
              </div>
            ))
          }
        </div>
      </div>
      <div class="space-y-2">
        <Label>URL</Label>
        <p data-edit-url class="text-muted-foreground text-sm break-all">
          {
            activeProduct?.url || (
              <span class="text-muted-foreground/50">—</span>
            )
          }
        </p>
      </div>
      <div class="space-y-2">
        <Label>Variants</Label>
        <div data-edit-variants class="space-y-2">
          {
            activeVariants.length > 0 ? (
              activeVariants.map((v) => (
                <div class="border-border rounded-lg border p-3 text-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-medium">{v.name}</span>
                    {v.feature && (
                      <span class="text-muted-foreground text-xs">
                        {v.feature}
                      </span>
                    )}
                  </div>
                  {v.description && (
                    <div class="text-muted-foreground mt-1 whitespace-pre-wrap">
                      {v.description}
                    </div>
                  )}
                  {v.url && (
                    <a
                      href={v.url}
                      target="_blank"
                      class="text-primary mt-1 block hover:underline">
                      {v.url}
                    </a>
                  )}
                </div>
              ))
            ) : (
              <p class="text-muted-foreground/50 text-sm">—</p>
            )
          }
        </div>
      </div>
      <div class="space-y-2">
        <Label for="main-image">Main image</Label>
        <div data-edit-main-image>
          {
            activeMainImage?.sizes?.medium?.filename ? (
              <PayloadImage
                src={`/payload/products/${activeMainImage.sizes.medium.filename}`}
                alt={activeProduct?.name ?? ""}
                width={128}
                height={128}
                class="h-auto w-32 rounded object-cover"
              />
            ) : (
              <span class="text-muted-foreground/50 text-sm">—</span>
            )
          }
        </div>
      </div>
      <SheetFooter>
        <Button type="submit">Save</Button>
        <SheetClose>Cancel</SheetClose>
      </SheetFooter>
    </form>
  </SheetContent>
</Sheet>

<script>
  const perPage = document.querySelector(
    "[data-per-page]",
  ) as HTMLSelectElement;
  if (perPage) {
    perPage.addEventListener("change", () => {
      const url = new URL(window.location.href);
      url.searchParams.set("limit", perPage.value);
      url.searchParams.delete("page");
      window.location.href = url.pathname + url.search;
    });
  }

  function buildUrl(editId?: string) {
    const url = new URL(window.location.href);
    if (editId) url.searchParams.set("edit", editId);
    else url.searchParams.delete("edit");
    return url.pathname + url.search;
  }

  function getEditParam() {
    return new URLSearchParams(window.location.search).get("edit") ?? "";
  }

  function closeSheet() {
    const btn = document.querySelector(
      "[data-sheet-content] [data-sheet-close]",
    );
    if (btn) (btn as HTMLElement).click();
  }

  function openSheet() {
    const content = document.querySelector("[data-sheet-content]");
    if (content) content.classList.remove("hidden");
    const trigger = document.getElementById("sheet-open-trigger");
    if (trigger) trigger.click();
  }

  function relationId(value: unknown): string {
    return value && typeof value === "object"
      ? String((value as { id: number | string }).id)
      : String(value ?? "");
  }

  function populateForm(product: {
    id: string | number;
    code?: string;
    name?: string;
    description?: string;
    published?: boolean;
    promoted?: boolean;
    category?: unknown;
    materials?: unknown[];
    url?: string;
    variants?: {
      name?: string;
      feature?: string;
      description?: string;
      url?: string;
    }[];
    main_image?: {
      url?: string;
      sizes?: {
        medium?: { url?: string; filename?: string };
      };
    } | null;
  }) {
    const f = document.getElementById("product-edit-form") as HTMLFormElement;
    if (!f) return;
    (f.querySelector("[name=id]") as HTMLInputElement).value = String(
      product.id,
    );
    (f.querySelector("[name=code]") as HTMLInputElement).value = String(
      product.code ?? "",
    );
    (f.querySelector("[name=name]") as HTMLInputElement).value = String(
      product.name ?? "",
    );
    (f.querySelector("[name=description]") as HTMLTextAreaElement).value =
      String(product.description ?? "");
    (f.querySelector("[name=published]") as HTMLInputElement).checked =
      !!product.published;
    (f.querySelector("[name=promoted]") as HTMLInputElement).checked =
      !!product.promoted;

    const categorySelect = f.querySelector(
      "[name=category]",
    ) as HTMLSelectElement;
    if (categorySelect) categorySelect.value = relationId(product.category);

    const materialCheckboxes = f.querySelectorAll(
      "[data-edit-materials] input[name=materials]",
    );
    const selectedMaterials = new Set(
      (product.materials ?? []).map((m) => relationId(m)),
    );
    materialCheckboxes.forEach((box) => {
      (box as HTMLInputElement).checked = selectedMaterials.has(
        (box as HTMLInputElement).value,
      );
    });

    const urlEl = f.querySelector("[data-edit-url]");
    if (urlEl) {
      urlEl.textContent = product.url ?? "";
      if (!product.url) urlEl.textContent = "—";
    }

    const variantsEl = f.querySelector("[data-edit-variants]");
    if (variantsEl) {
      variantsEl.textContent = "";
      const variants = product.variants ?? [];
      if (variants.length === 0) {
        variantsEl.textContent = "—";
      } else {
        variants.forEach((v) => {
          const box = document.createElement("div");
          box.className = "rounded-lg border border-border p-3 text-sm";
          const head = document.createElement("div");
          head.className = "flex items-center justify-between gap-2";
          const name = document.createElement("span");
          name.className = "font-medium";
          name.textContent = v.name ?? "";
          head.appendChild(name);
          if (v.feature) {
            const feat = document.createElement("span");
            feat.className = "text-muted-foreground text-xs";
            feat.textContent = v.feature;
            head.appendChild(feat);
          }
          box.appendChild(head);
          if (v.description) {
            const desc = document.createElement("div");
            desc.className = "mt-1 whitespace-pre-wrap text-muted-foreground";
            desc.textContent = v.description;
            box.appendChild(desc);
          }
          if (v.url) {
            const link = document.createElement("a");
            link.href = v.url;
            link.target = "_blank";
            link.className = "mt-1 block text-primary hover:underline";
            link.textContent = v.url;
            box.appendChild(link);
          }
          variantsEl.appendChild(box);
        });
      }
    }

    const imgEl = f.querySelector("[data-edit-main-image]");
    if (imgEl) {
      imgEl.textContent = "";
      const url =
        product.main_image?.sizes?.medium?.url ?? product.main_image?.url;
      if (url) {
        const img = document.createElement("img");
        img.src = url;
        img.alt = product.name ?? "";
        img.width = 128;
        img.height = 128;
        img.className = "h-auto w-32 rounded object-cover";
        imgEl.appendChild(img);
      } else {
        const span = document.createElement("span");
        span.className = "text-muted-foreground/50 text-sm";
        span.textContent = "—";
        imgEl.appendChild(span);
      }
    }
  }

  function updateRow(
    id: string,
    data: {
      code?: string;
      name?: string;
      published?: boolean;
      category?: { id: number | string; name?: string } | number | string;
      materials?: ({ id: number | string; name?: string } | number | string)[];
    },
  ) {
    const row = document.querySelector(`[data-product-id="${id}"]`);
    if (!row) return;
    const cells = row.querySelectorAll("td");
    if (data.code !== undefined && cells[1]) cells[1].textContent = data.code;
    if (data.published !== undefined && cells[2]) {
      const box = cells[2].querySelector("input[type=checkbox]");
      if (box) (box as HTMLInputElement).checked = !!data.published;
    }
    if (data.name !== undefined && cells[3]) cells[3].textContent = data.name;
    if (data.category !== undefined && cells[6]) {
      const name =
        data.category && typeof data.category === "object"
          ? data.category.name
          : undefined;
      cells[6].textContent = name ?? "—";
    }
    if (data.materials !== undefined && cells[7]) {
      cells[7].textContent =
        data.materials
          .map((m) => (typeof m === "object" ? m.name : undefined))
          .filter(Boolean)
          .join(", ") || "—";
    }
  }

  async function openEditSheet(id: string) {
    try {
      const res = await fetch(`/api/products/${id}`);
      if (!res.ok) return;
      const product = await res.json();
      populateForm(product);
      openSheet();
    } catch {
      /* silent */
    }
  }

  function removeEditFromUrl() {
    if (getEditParam()) {
      history.replaceState({}, "", buildUrl());
    }
  }

  // Row click → open edit sheet without page reload
  document.querySelectorAll("[data-product-id]").forEach((row) => {
    row.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a, button, input, select")) return;
      const id = row.getAttribute("data-product-id");
      if (!id) return;
      history.pushState({ editId: id }, "", buildUrl(id));
      openEditSheet(id);
    });
  });

  // Save form
  const form = document.getElementById("product-edit-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const id = (form.querySelector("[name=id]") as HTMLInputElement).value;
      const materialInputs = Array.from(
        form.querySelectorAll("[data-edit-materials] input[name=materials]"),
      ) as HTMLInputElement[];
      const materialIds = materialInputs
        .filter((box) => box.checked)
        .map((box) => box.value);
      const data = {
        code: (form.querySelector("[name=code]") as HTMLInputElement).value,
        name: (form.querySelector("[name=name]") as HTMLInputElement).value,
        description: (
          form.querySelector("[name=description]") as HTMLTextAreaElement
        ).value,
        published: (form.querySelector("[name=published]") as HTMLInputElement)
          .checked,
        promoted: (form.querySelector("[name=promoted]") as HTMLInputElement)
          .checked,
        category:
          (form.querySelector("[name=category]") as HTMLSelectElement).value ||
          null,
        materials: materialIds,
      };

      const res = await fetch(`/api/products/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        const updated = await res.json();
        history.replaceState({}, "", buildUrl());
        closeSheet();
        updateRow(id, updated);
      }
    });
  }

  // Close sheet buttons → remove edit param from URL
  document.querySelectorAll("[data-sheet-close]").forEach((btn) => {
    btn.addEventListener("click", removeEditFromUrl);
  });

  // Overlay click → remove edit param from URL
  const overlay = document.querySelector("[data-sheet-overlay]");
  if (overlay) {
    overlay.addEventListener("click", removeEditFromUrl);
  }

  // Escape key → remove edit param from URL
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") removeEditFromUrl();
  });

  // Browser back/forward
  window.addEventListener("popstate", () => {
    const editId = getEditParam();
    if (editId) openEditSheet(editId);
    else {
      const content = document.querySelector(
        "[data-sheet-content]",
      ) as HTMLElement;
      const overlayEl = document.querySelector(
        "[data-sheet-overlay]",
      ) as HTMLElement;
      if (content && !content.hidden) closeSheet();
    }
  });

  // Auto-open sheet on initial page load when edit param is present
  const initialEditId = getEditParam();
  if (initialEditId) {
    const trigger = document.getElementById("sheet-open-trigger");
    if (trigger) {
      setTimeout(() => trigger.click(), 50);
    }
  }
</script>
