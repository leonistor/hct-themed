---
import type { Product } from "shared";
import type { HugeIconData } from "@/components/ui/basecoat/Icon.astro";
import Icon from "@/components/ui/basecoat/Icon.astro";
import PayloadImage from "@/layouts/components/utilities/PayloadImage.astro";
import {
  CheckmarkCircle01Icon,
  Layers01Icon,
} from "@/components/ui/basecoat/hugeicons";

export interface Props {
  products?: Product[];
  editId?: string;
  sortHref: (field: string) => string;
  sortIcon: (field: string) => HugeIconData;
  sortIconClass: (field: string) => string;
}

const {
  products = [],
  editId = "",
  sortHref,
  sortIcon,
  sortIconClass,
} = Astro.props;
---

<div class="overflow-x-auto rounded-lg border">
  <table class="w-full text-left text-sm">
    <thead class="bg-muted/50 text-muted-foreground">
      <tr>
        <th class="p-3" style="width: 12.5%">Image</th>
        <th class="p-3" style="width: 4.17%">
          <a
            href={sortHref("published")}
            class="flex items-center justify-between gap-1 hover:underline">
            <Icon icon={CheckmarkCircle01Icon} class="size-4" />
            <Icon
              icon={sortIcon("published")}
              class:list={["size-3.5", sortIconClass("published")]}
            />
          </a>
        </th>
        <th class="p-3" style="width: 29.16%">
          <a
            href={sortHref("name")}
            class="flex items-center justify-between gap-1 hover:underline">
            <span>Name</span>
            <Icon
              icon={sortIcon("name")}
              class:list={["size-3.5", sortIconClass("name")]}
            />
          </a>
        </th>
        <th class="p-3" style="width: 4.17%">
          <Icon icon={Layers01Icon} class="size-4" />
        </th>
        <th class="p-3" style="width: 8.33%">
          <a
            href={sortHref("partner")}
            class="flex items-center justify-between gap-1 hover:underline">
            <span>Partner</span>
            <Icon
              icon={sortIcon("partner")}
              class:list={["size-3.5", sortIconClass("partner")]}
            />
          </a>
        </th>
        <th class="p-3" style="width: 20.83%">
          <a
            href={sortHref("category")}
            class="flex items-center justify-between gap-1 hover:underline">
            <span>Category</span>
            <Icon
              icon={sortIcon("category")}
              class:list={["size-3.5", sortIconClass("category")]}
            />
          </a>
        </th>
        <th class="p-3" style="width: 20.83%">Materials</th>
      </tr>
    </thead><tbody>
      {
        products.map((product) => {
          const mainImage = product.main_image as unknown as {
            sizes?: { medium?: { filename?: string } };
          } | null;
          const mediumImage = mainImage?.sizes?.medium?.filename;
          const partner = product.partner;
          const category = product.category;
          const materials = product.materials ?? [];
          const variantsCount = product.variants?.length ?? 0;
          const isActive = String(product.id) === editId;

          return (
            <tr
              data-product-id={product.id}
              class:list={[
                "hover:bg-muted/50 cursor-pointer transition-colors",
                isActive && "bg-accent",
              ]}>
              <td class="p-3">
                {mediumImage ? (
                  <PayloadImage
                    src={`/payload/products/${mediumImage}`}
                    alt={product.name}
                    width={48}
                    height={48}
                    class="h-auto w-full rounded object-cover"
                  />
                ) : (
                  <span class="text-muted-foreground">—</span>
                )}
              </td>
              <td class="p-3">
                <input
                  type="checkbox"
                  checked={product.published ?? false}
                  disabled
                />
              </td>
              <td class="p-3 font-medium">{product.name}</td>
              <td class="p-3">{variantsCount > 0 ? variantsCount : "—"}</td>
              <td class="p-3">
                {typeof partner === "object" && partner ? partner.name : "—"}
              </td>
              <td class="p-3">
                {typeof category === "object" && category ? category.name : "—"}
              </td>
              <td class="p-3">
                {materials
                  .map((material) =>
                    typeof material === "object" && material
                      ? material.name
                      : "—",
                  )
                  .join(", ")}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
