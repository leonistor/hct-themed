---
import NewBadge from "@/components/ui/NewBadge.astro";
import Pill from "@/components/ui/Pill.astro";
import PillButton from "@/components/ui/PillButton.astro";
import PayloadImage from "@/layouts/components/utilities/PayloadImage.astro";

import type { Category, Material, Media, Partner, Product } from "admin";

import { useTranslations } from "@/lib/utils/i18nUtils";

type Props = {
  index?: number;
  product: Product;
};

let { index = 0, product } = Astro.props;

const t = await useTranslations(Astro.currentLocale as string);

const color_variants = "#216869";

const variants_count = product.variants?.length ?? 0;
const is_promoted = product.promoted ?? false;
---

<div
  class="group relative flex flex-col gap-y-1 bg-gray-100 px-4 pt-3 pb-4"
  data-aos="fade-up-sm"
  data-aos-duration="700"
  data-aos-delay={index * 100}>
  <a
    href={`/product/${product.code}`}
    class:list={[
      "relative mb-3 overflow-hidden xl:mb-6",
      "grow self-stretch",
      "flex flex-col justify-between",
    ]}
    aria-label={product.name}>
    <div
      class:list={[
        "text-primary text-h6-sm lg:text-h5 xl:text-h4 opacity-80",
        "pb-2 group-hover:opacity-100",
        "leading-tight font-medium tracking-tight text-balance",
      ]}>
      {product.name}
    </div>
    {
      product.main_image! && (
        <PayloadImage
          src={`/payload/products/${(product.main_image! as Media).sizes!.large!.filename!}`}
          alt={product.name}
          height="300px"
          class:list={[
            "mx-auto object-scale-down",
            "transition-transform duration-700 ease-in-out group-hover:scale-105",
          ]}
        />
      )
    }
  </a>

  <!-- <div class="grow"></div> -->
  {is_promoted && <NewBadge />}
  <div class="flex flex-wrap gap-2">
    <Pill partner={product.partner as Partner} />
    <Pill category={product.category as Category} />
    {
      product.materials &&
        product.materials.map((material) => (
          <Pill material={material as Material} />
        ))
    }
    {
      variants_count > 0 && (
        <PillButton
          label={`${variants_count} ${t("products.variants")}`}
          link={`/product/${product.code}`}
          bgColor={color_variants}
        />
      )
    }
  </div>
</div>
