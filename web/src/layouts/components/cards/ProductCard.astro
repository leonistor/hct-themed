---
import { Image } from "astro:assets";
import Pill from "@/components/ui/Pill.astro";
import PillButton from "@/components/ui/PillButton.astro";

import type { Media, Partner, Product, Category, Material } from "admin";

import { useTranslations } from "@/lib/utils/i18nUtils";

type Props = {
  index?: number;
  product: Product;
};

let { index = 0, product } = Astro.props;

const t = await useTranslations(Astro.currentLocale as string);

let variants_count = product.variants?.length ?? 0;
---

<div
  class="group relative flex flex-col gap-y-1 bg-gray-50 px-4 py-2"
  data-aos="fade-up-sm"
  data-aos-duration="700"
  data-aos-delay={index * 100}>
  <a
    href={`/product/${product.code}`}
    class:list={["relative mb-3 overflow-hidden xl:mb-6"]}
    aria-label={product.name}>
    <div
      class:list={[
        "text-primary text-h6-sm lg:text-h5 xl:text-h4 opacity-75",
        "pb-2 group-hover:opacity-100",
        "leading-tight font-medium tracking-tight text-balance",
      ]}>
      {product.name}
    </div>
    {
      product.main_image! && (
        <Image
          src={(product.main_image! as Media).url!}
          alt={product.name}
          width={360}
          height={100}
          class:list={[
            "w-full object-cover",
            "transition-transform duration-700 ease-in-out group-hover:scale-105",
          ]}
        />
      )
    }
  </a>

  <div class="grow"></div>
  {
    variants_count > 0 && (
      <span
        title={`${variants_count} variant${variants_count !== 1 ? "s" : ""}`}
        class:list={[
          "absolute inset-e-0 top-0 inline-flex items-center rounded-full",
          "px-1.5 py-0.5 text-base font-light",
          "translate-x-1/2 -translate-y-1/2",
          "transform bg-orange-600 text-white",
        ]}>
        {variants_count}
      </span>
    )
  }
  <div class="flex flex-wrap gap-2">
    <Pill partner={product.partner as Partner} />
    <Pill category={product.category as Category} />
    {
      product.materials &&
        product.materials.map((material) => (
          <Pill material={material as Material} />
        ))
    }
    {
      variants_count > 0 && (
        <PillButton
          label={`${variants_count} ${t("products.variants")}`}
          link={`/product/${product.code}`}
          bgColor="#f97316"
        />
      )
    }
  </div>
</div>
