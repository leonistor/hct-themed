---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import type { Media, Product } from "admin";

type Props = {
  index?: number;
  product: Product;
};

let { index = 0, product } = Astro.props;
---

<div
  class="group flex flex-col bg-gray-50 px-4 py-2"
  data-aos="fade-up-sm"
  data-aos-duration="700"
  data-aos-delay={index * 100}>
  <a
    href={`/products/${product.code}`}
    class:list={["relative mb-3 overflow-hidden xl:mb-6"]}
    aria-label={product.name}>
    {
      product.main_image! && (
        <Image
          src={`http://localhost:3000${(product.main_image! as Media).url}`}
          alt={product.name}
          width={360}
          height={100}
          class:list={[
            "w-full object-cover",
            "transition-transform duration-700 ease-in-out group-hover:scale-105",
          ]}
        />
      )
    }
  </a>

  <div class="">
    <div class="flex flex-col gap-2">
      <h3 class="flex">
        <Button
          tag="a"
          variant="text"
          url={`/products/${product.code}`}
          label={product.name}
          aria-label={product.name}
          class="text-text-dark group-hover:text-primary text-h5-sm lg:text-h6 xl:text-h5 group-hover:border-b-primary! min-w-0 border-transparent whitespace-normal"
        />
      </h3>
      <p class="text-neutral-500">{product.description}</p>
    </div>
  </div>
</div>
