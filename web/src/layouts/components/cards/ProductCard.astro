---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Pill from "@/components/ui/Pill.astro";

import type { Media, Partner, Product, Category, Material } from "admin";

type Props = {
  index?: number;
  product: Product;
};

let { index = 0, product } = Astro.props;
---

<div
  class="group flex flex-col gap-y-1 bg-gray-50 px-4 py-2"
  data-aos="fade-up-sm"
  data-aos-duration="700"
  data-aos-delay={index * 100}>
  <a
    href={`/products/${product.code}`}
    class:list={["relative mb-3 overflow-hidden xl:mb-6"]}
    aria-label={product.name}>
    <div
      class:list={[
        "text-primary text-h6-sm lg:text-h5 xl:text-h4 opacity-75",
        "pb-2 group-hover:opacity-100",
        "leading-tight font-medium tracking-tight text-balance",
      ]}>
      {product.name}
    </div>
    {
      product.main_image! && (
        <Image
          src={(product.main_image! as Media).url!}
          alt={product.name}
          width={360}
          height={100}
          class:list={[
            "w-full object-cover",
            "transition-transform duration-700 ease-in-out group-hover:scale-105",
          ]}
        />
      )
    }
  </a>

  <div class="grow"></div>

  <div class="flex flex-wrap gap-2">
    <Pill partner={product.partner as Partner} />
    <Pill category={product.category as Category} />
    {
      product.materials &&
        product.materials.map((material) => (
          <Pill material={material as Material} />
        ))
    }
  </div>
</div>
