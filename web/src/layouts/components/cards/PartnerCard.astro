---
import PayloadImage from "@/layouts/components/utilities/PayloadImage.astro";
import Button from "@/components/Button.astro";
import type { Media, Partner } from "shared";

type Props = {
  index?: number;
  partner: Partner;
};

let { index = 0, partner } = Astro.props;
---

<div
  class="group flex flex-col bg-gray-100 px-4 py-2"
  data-aos="fade-up-sm"
  data-aos-duration="700"
  data-aos-delay={index * 100}>
  <a
    href={`/partners/${partner.code}`}
    class:list={["relative mb-3 overflow-hidden xl:mb-6"]}
    aria-label={partner.name}>
    {
      partner.logo && (
        <PayloadImage
          src={`/payload/${(partner.logo as Media).filename!}`}
          alt={partner.name}
          width={360}
          height={100}
          class:list={[
            "w-full object-cover",
            "transition-transform duration-700 ease-in-out group-hover:scale-105",
          ]}
        />
      )
    }
  </a>

  <div class="">
    <div class="flex flex-col gap-2">
      <h3 class="flex">
        <Button
          tag="a"
          variant="text"
          url={`/partners/${partner.code}`}
          label={partner.name}
          aria-label={partner.name}
          class="text-text-dark group-hover:text-primary text-h5-sm lg:text-h6 xl:text-h5 group-hover:border-b-primary! min-w-0 border-transparent whitespace-normal"
        />
      </h3>
      <p class="text-neutral-500">{partner.description}</p>
    </div>
  </div>
</div>
