---
import PayloadImage from "@/layouts/components/utilities/PayloadImage.astro";
import Icons from "@/helpers/Icons.astro";
import type { Media, Customer } from "shared";

type Props = {
  index?: number;
  customer: Customer;
};

let { index = 0, customer } = Astro.props;
---

<div
  class="group flex flex-col bg-gray-50 px-4 py-2"
  data-aos="fade-up-sm"
  data-aos-duration="700"
  data-aos-delay={index * 100}>
  <a
    href={customer.url ?? "#"}
    target="_blank"
    class:list={["relative mb-3 overflow-hidden xl:mb-6"]}
    aria-label={customer.name}>
    {
      customer.logo && (
        <PayloadImage
          src={`/payload/${(customer.logo as Media).filename!}`}
          alt={customer.name}
          class:list={[
            "mx-auto size-40 object-scale-down",
            "transition-transform duration-700 ease-in-out group-hover:scale-105",
          ]}
        />
      )
    }
  </a>
  <div class="grow"></div>
  <div class="text-center text-neutral-500">
    <span class="text-xl font-medium">{customer.name}</span><br />
    {customer.location!}{
      customer.url && (
        <span>
          <a href={customer.url} class="text-base" target="_blank">
            <Icons icon="ArrowUpRight" class="inline-block size-6" />
          </a>
        </span>
      )
    }
  </div>
</div>
