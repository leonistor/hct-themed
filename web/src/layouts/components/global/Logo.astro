---
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils.ts";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { markdownify, toSentenceCase } from "@/lib/utils/textConverter";

import config from "../../../config/config.generated.json";

type Props = {
  src?: string;
  class?: string;
  width?: string;
  height?: string;
  [key: string]: any;
};

let { src, class: className } = Astro.props;

let {
  logo,
  logoWidth = "300px",
  logoHeight = "48px",
  logoText,
  logoAlternate,
  title,
}: {
  logo: string;
  logoAlternate: string;
  logoWidth: string;
  logoHeight: string;
  logoText: string;
  title: string;
} = config.site;

if (Astro.props.width) {
  logoWidth = Astro.props.width;
}
if (Astro.props.height) {
  logoHeight = Astro.props.height;
}
---

<a
  href={getLocaleUrlCTM("/", Astro.currentLocale)}
  class:list={["logo-wrapper py-2 lg:py-3", className]}>
  {
    src || logoAlternate || logo ? (
      <>
        <OptimizedImage
          src={src ? src : logo}
          class="logo max-sm:h-10! max-sm:w-44!"
          alt={toSentenceCase("Brand logo of " + title)}
          style={{
            height: logoHeight,
            width: logoWidth,
          }}
        />
        {logoAlternate && (
          <OptimizedImage
            src={logoAlternate}
            class="logo-alternate"
            alt={toSentenceCase("Brand logo of " + title)}
            style={{
              height: logoHeight,
              width: logoWidth,
            }}
          />
        )}

        {logoText && false && (
          <span class="logo-text" set:html={markdownify(logoText)} />
        )}
      </>
    ) : logoText ? (
      logoText
    ) : (
      title
    )
  }
</a>
