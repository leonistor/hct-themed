---
import Logo from "@/components/global/Logo.astro";
import config from "@/config/config.generated.json";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";
import NavbarToggler from "@/layouts/components/global/header/NavbarToggler.astro";
import HeaderOffcanvasContent from "@/components/widgets/HeaderOffcanvasContent.astro";
import Navbar from "./Navbar.astro";
import TopBarTwo from "./TopBarTwo.astro";
import Icons from "@/helpers/Icons.astro";
import { markdownify } from "@/lib/utils/textConverter";
import WhatsApp from "@/assets/images/WhatsApp.svg";

const t = await useTranslations(Astro.currentLocale as string);

const {
  settings: {
    stickyHeader,
    navigationButton,
    headerOffcanvas,
    contactInfo,
    announcementBar,
  },
} = config;
const announcementEnabled = announcementBar?.enable;
const announcement = announcementBar?.label || t("header.announcement");

const { position, hideOffcanvas, class: ClassName } = Astro.props;
---

<TopBarTwo announcement={announcementEnabled ? announcement : null} />

<header
  class:list={[
    "bg-light header group/header transform",
    { sticky: position === "sticky" },
    { fixed: position === "fixed" },
    { "has-sticky-behavior": stickyHeader || position === "fixed" },
    ClassName,
  ]}>
  <div class="relative container rounded-b-2xl">
    <div
      class="hs-dropdown relative flex flex-wrap items-stretch justify-between [--auto-close:inside] [--gpu-acceleration:false] [--strategy:absolute] lg:justify-center lg:[--strategy:static]">
      <div
        class:list={["logo-section  after:bg-accent relative z-10 flex transform flex-row-reverse",
          "items-center justify-center gap-2 py-4 pe-6",
          "after:pointer-events-none after:absolute after:right-0 after:-z-10 after:h-full after:w-screen after:-skew-x-20 after:select-none",
          "lg:flex-row lg:py-2 xl:pe-10"]}>

            {/* shrink-0 keeps the logo from being squeezed on narrow phones;
                the logo link already provides a comfortable >=44px tap target */}
            <Logo class="w-32.5 h-22.5 shrink-0" />

      </div>

      {/* Navbar For Header */}
      <Navbar hasActiveBorder={true} />

      {/* Navigation Actions - Search + CTA Button */}
      {
        (navigationButton.enable || config.settings.multilingual.enable) && (
          <div class="hidden gap-3.5 justify-self-end max-lg:ms-auto max-lg:me-4 lg:items-center xl:flex">
            <a href="/contact" class="flex items-center gap-2">
              <!-- <Icons icon="MessagesSquare" class="stroke-accent size-8" /> -->
              <WhatsApp class=" size-9" />
              <div>
                <div class="text-sm opacity-80">{t("common.letsChat")}</div>
                <div
                  class="font-secondary leading-none font-medium"
                  set:html={markdownify(contactInfo.phone)}
                />
              </div>
            </a>
          </div>
        )
      }

      {/* Desktop Sidebar Offcanvas Toggle Button */}
      {
        headerOffcanvas?.enable && (
          <NavbarToggler
            title="Open sidebar content"
            isOffcanvasToggler={true}
            class:list={[
              // min-h-11/min-w-11 (44px) guarantee a compliant tap target
              // even though the parent flex stretches it vertically
              "ring-primary/25 rounded-full duration-500 ease-out min-h-11 min-w-11 focus-visible:ring-2 focus-visible:ring-primary",
              hideOffcanvas ? "lg:hidden" : "",
            ]}
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="offcanvas-main"
            data-offcanvas-toggle="offcanvas-main"
          />
        )
      }
    </div>
  </div>
</header>

<div>
  {/* Mobile Offcanvas
     Rendered as a manually-controlled fixed overlay instead of a native
     `<dialog>.showModal()` so the menu renders reliably on iOS Safari, where
     the modal top layer fails to paint the panel content (only the `::backdrop`
     blur is shown). Behaviour is identical everywhere else. */}
  {
    headerOffcanvas?.enable && (
      <div
        id="offcanvas-main"
        class="offcanvas-overlay"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
        data-offcanvas="offcanvas-main">
        <button
          type="button"
          class="offcanvas-backdrop"
          aria-label="Close menu"
          tabindex="-1"
          data-offcanvas-close></button>
        <div class="offcanvas-panel">
          <HeaderOffcanvasContent offcanvas={"offcanvas-main"} />
        </div>
      </div>
    )
  }
  <script>
    function updateMegaMenuOffset(): void {
      const header = document.querySelector(".header") as HTMLElement | null;
      if (!header) return;

      const headerBottom = Math.round(header.getBoundingClientRect().bottom);
      document.documentElement.style.setProperty(
        "--header-bottom",
        `${Math.max(headerBottom, 0)}px`,
      );
    }

    function stickyHeader(): void {
      const header = document.querySelector(
        ".has-sticky-behavior",
      ) as HTMLElement | null;
      if (!header) return;

      let prevScrollPos = window.scrollY;
      let ticking = false;

      // Initial state
      if (prevScrollPos > 0) {
        header.classList.add("scroll-up");
      }
      updateMegaMenuOffset();

      const updateHeader = () => {
        const currentScrollPos = Math.max(0, window.scrollY);

        if (currentScrollPos === 0) {
          header.classList.remove("scroll-up", "scroll-down");
        } else {
          header.classList.add("scroll-up");
        }

        updateMegaMenuOffset();
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            window.requestAnimationFrame(updateHeader);
            ticking = true;
          }
        },
        { passive: true },
      );
      window.addEventListener("resize", updateMegaMenuOffset, {
        passive: true,
      });
    }

    function initOffcanvas(id: string): void {
      const overlay = document.querySelector<HTMLElement>(
        `[data-offcanvas="${id}"]`,
      );
      if (!overlay) return;
      const toggler = document.querySelector<HTMLElement>(
        `[data-offcanvas-toggle="${id}"]`,
      );

      const setOpen = (open: boolean) => {
        overlay.setAttribute("data-open", String(open));
        overlay.setAttribute("aria-hidden", String(!open));
        toggler?.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("no-scroll", open);
      };

      // Toggle from the hamburger button (delegated on click).
      toggler?.addEventListener("click", () => {
        setOpen(overlay.getAttribute("data-open") !== "true");
      });

      // Close from the backdrop or any element marked `data-offcanvas-close`.
      overlay
        .querySelectorAll<HTMLElement>("[data-offcanvas-close]")
        .forEach((el) => el.addEventListener("click", () => setOpen(false)));

      // Close on Escape.
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && overlay.getAttribute("data-open") === "true") {
          setOpen(false);
        }
      });

      setOpen(false);
    }

    initOffcanvas("offcanvas-main");
    stickyHeader();
  </script>

  <style>
    .offcanvas-overlay {
      position: fixed;
      inset: 0;
      z-index: 80;
      visibility: hidden;
    }
    .offcanvas-overlay[data-open="true"] {
      visibility: visible;
    }
    .offcanvas-backdrop {
      position: absolute;
      inset: 0;
      background: rgb(0 0 0 / 0.14);
      opacity: 0;
      transition: opacity 0.3s ease;
      cursor: pointer;
      border: 0;
      padding: 0;
    }
    .offcanvas-overlay[data-open="true"] .offcanvas-backdrop {
      opacity: 1;
    }
    .offcanvas-panel {
      position: absolute;
      inset: 0;
      margin: auto;
      height: 100%;
      width: min(34rem, calc(100vw - 2.5rem));
      background: var(--color-light);
      overflow: hidden;
      box-shadow: 0 20px 60px -24px rgb(0 0 0 / 0.35);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .offcanvas-overlay[data-open="true"] .offcanvas-panel {
      opacity: 1;
    }
    :global(body.no-scroll) {
      overflow: hidden;
    }
  </style>
</div>
