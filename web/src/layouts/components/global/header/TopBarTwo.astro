---
import config from "../../../../config/config.generated.json";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";
import { markdownify } from "@/lib/utils/textConverter";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Icons from "@/layouts/helpers/Icons.astro";
import HCT from "./HCT.astro";

const t = await useTranslations(Astro.currentLocale as string);

const { announcement } = Astro.props;

const {
  settings: { contactInfo },
} = config;
---

<div class="topbar bg-primary">
  <div class="container">
    <div
      class:list={[
        "flex flex-col items-center justify-between",
        "gap-2 py-2 md:flex-row md:gap-4",
      ]}>
      <div class=""><HCT /></div>
      <div
        class="flex flex-col items-center justify-center gap-2 md:flex-row xl:justify-end xl:gap-4">
        <a
          href="/vsu"
          class="bg-accent px-4 py-3 text-lg font-medium text-white hover:text-black">
          <Icons
            icon="Play"
            class="-mt-1 ml-2 inline-block size-6 stroke-gray-200"
          />
          {t("vsu.headline")}
        </a>

        {
          config.settings.multilingual.enable && (
            <LanguageSwitcher appearance="light" />
          )
        }
      </div>
    </div>
  </div>
</div>
