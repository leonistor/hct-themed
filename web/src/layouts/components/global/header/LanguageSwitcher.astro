---
import Icons from "@/helpers/Icons.astro";
import { localizedPath, supportedLanguages, getLanguageName } from "@/lib/i18n";
import trailingSlashChecker from "@/lib/utils/trailingSlashChecker";
import DropdownMenu from "@/layouts/components/ui/basecoat/DropdownMenu.astro";

const currentLocale = Astro.currentLocale;
const languages = supportedLanguages.map((lang) => {
  const href = localizedPath(Astro.url.pathname, lang.languageCode as string);

  // Don't include current locale in url
  if (href === trailingSlashChecker(Astro.url.pathname)) {
    return;
  }

  return {
    slug: href,
    ...lang,
  };
});
---

<DropdownMenu
  id="language-switcher"
  buttonVariant="ghost"
  triggerClass="language-switcher-button flex items-center gap-1.5 bg-transparent"
>
  <span slot="trigger" class="text">
    {getLanguageName(currentLocale!)}
  </span>
  <Icons
    slot="trigger"
    icon="ChevronDown"
    class="chevron w-3.5 transition-transform duration-300"
  />
  <ul class="min-w-32">
    {
      languages.map(
        (language) =>
          language && (
            <li>
              <a
                class:list={[
                  {
                    active: language.languageCode === currentLocale,
                  },
                  "text-md font-normal capitalize",
                ]}
                href={language.slug}
                role="menuitem"
                set:html={language.contentDir}
              />
            </li>
          ),
      )
    }
  </ul>
</DropdownMenu>
