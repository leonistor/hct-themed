---
import SEO from "@/components/seo/Seo.astro";
import OpenGraph from "@/components/seo/OpenGraph.astro";
import Favicons from "@/components/seo/Favicons.astro";
import JsonLD from "../widgets/JsonLD.astro";
import config from "../../../config/config.generated.json";
import { Font } from "astro:assets";
import fontsJson from "@/config/fonts.json";

const fontVariables = fontsJson.map((font) => font.cssVariable) as any[];
---

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Language" content={Astro.currentLocale} />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=5"
  />
  <SEO {...Astro.props} />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content={"#fff"}
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#000"
  />
  <meta name="generator" content={Astro.generator} />
  {config.head?.content && <Fragment set:html={config.head?.content} />}
  <OpenGraph {...Astro.props} />
  <Favicons />
  <JsonLD
    content={{
      ...Astro.props,
    }}
  />

  <!------------------
    Fonts
-------------------->
  {fontVariables.map((font) =>
    // Preload the critical above-the-fold face (Work Sans 400/500, latin subset).
    // latin-ext is intentionally NOT preloaded: it only covers Romanian diacritics
    // (ă/ș/ț) which are below the fold / non-critical, and keeping the preload to
    // the common `latin` subset avoids wasting mobile bandwidth.
    font === "--font-primary" ? (
      <Font
        cssVariable={font}
        preload={[{ weight: "400", subset: "latin" }, { weight: "500", subset: "latin" }]}
      />
    ) : (
      <Font cssVariable={font} />
    )
  )}
</head>
