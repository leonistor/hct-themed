---
import Icons from "@/helpers/Icons.astro";
import { markdownify } from "@/lib/utils/textConverter";
import uniqueIdGenerator from "@/lib/utils/uniqueIdGenerator";

interface Props {
  content: any;
  class?: string;
  mode?: "light" | "dark" | "transparent" | "shadow";
  [key: string]: any;
}

const { content: list, mode = "light", ...rest } = Astro.props;
const instanceId = Math.random().toString(36).substring(2, 9);
const isMultiple = Boolean(rest["data-hs-accordion-always-open"]);
---

<div
  class:list={["accordion mx-auto flex w-full flex-col gap-4", rest.class]}
  data-multiple={isMultiple ? "" : undefined}
>
  {
    list.map((item: { title: string; content: string }, index: number) => {
      const id = uniqueIdGenerator(item.title);
      const accordionId = `accordion-${instanceId}-${id}`;
      const contentId = `content-${instanceId}-${id}`;

      return (
        <details
          class:list={[
            "group accordion-item relative px-4 py-1 text-start transition-all lg:px-6",
            mode === "dark"
              ? "bg-light"
              : mode === "transparent"
                ? "border-primary/40 text-text-light border bg-transparent"
                : mode === "shadow"
                  ? "bg-light shadow-lg"
                  : "bg-body",
            index === 0 && "active",
          ]}
          id={accordionId}
          open={index === 0}
        >
          <summary
            class:list={[
              "font-secondary text-h6 flex w-full cursor-pointer list-none items-center justify-between border-b border-transparent py-5.5 text-start font-medium",
              mode === "transparent"
                ? "group-open:border-primary/40 group-open:text-accent"
                : mode === "shadow"
                  ? "group-open:border-border-dark/10"
                  : "group-open:border-border-light",
            ]}>
            <h3
              set:html={markdownify(item.title)}
              class="text-h6 sm:text-h6-sm text-inherit"
            />
            <span class="text-inherit pointer-events-none flex transition duration-300 group-open:-rotate-90">
              <Icons icon="ArrowDownRight" class="text-xl" />
            </span>
          </summary>
          <div
            id={contentId}
            class="accordion-content py-4"
            aria-labelledby={accordionId}>
            <div
              set:html={markdownify(item.content, false)}
              class:list={["text-inherit opacity-90"]}
            />
          </div>
        </details>
      );
    })
  }
</div>
