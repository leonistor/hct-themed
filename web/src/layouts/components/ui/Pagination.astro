---
import { useTranslations } from "@/lib/utils/i18nUtils";

interface Props {
  totalDocs: number;
  hasPrevPage: boolean;
  hasNextPage: boolean;
  prevUrl: string;
  nextUrl: string;
  label: string;
  currentPage?: number;
  totalPages?: number;
}

const {
  totalDocs,
  hasPrevPage,
  hasNextPage,
  prevUrl,
  nextUrl,
  label,
  currentPage,
  totalPages,
} = Astro.props;

const t = await useTranslations(Astro.currentLocale as string);
---

<div
  class="flex flex-wrap items-baseline justify-end gap-x-4 gap-y-2 pt-4 pb-6 text-sm">
  <div class="font-semibold">
    {totalDocs + " " + label}
  </div>
  {
    hasPrevPage && (
      <a href={prevUrl} class="">
        &larr; {t("products.paginationPrevious")}
      </a>
    )
  }
  {
    hasNextPage && (
      <a href={nextUrl} class="">
        {t("products.paginationNext")} &rarr;
      </a>
    )
  }
  {
    currentPage && totalPages && (
      <span class="font-semibold">
        {t("products.paginationInfo", {
          current: currentPage,
          total: totalPages,
        })}
      </span>
    )
  }
</div>
