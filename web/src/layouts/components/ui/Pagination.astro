---
import { useTranslations } from "@/lib/utils/i18nUtils";

interface Props {
  totalDocs: number;
  hasPrevPage: boolean;
  hasNextPage: boolean;
  prevUrl: string;
  nextUrl: string;
  label: string;
  currentPage?: number;
  totalPages?: number;
}

const {
  totalDocs,
  hasPrevPage,
  hasNextPage,
  prevUrl,
  nextUrl,
  label,
  currentPage,
  totalPages,
} = Astro.props;

const t = await useTranslations(Astro.currentLocale as string);
---

<div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 pt-4 pb-6">
  <div class="font-medium">
    {totalDocs + " " + label}
  </div>
  {
    hasPrevPage && (
      <a href={prevUrl} class="btn" data-variant="ghost" data-size="sm">
        &larr; {t("products.paginationPrevious")}
      </a>
    )
  }
  {
    hasNextPage && (
      <a href={nextUrl} class="btn" data-variant="ghost" data-size="sm">
        {t("products.paginationNext")} &rarr;
      </a>
    )
  }
  {
    currentPage && totalPages && (
      <span class="text-muted-foreground text-sm">
        {t("products.paginationInfo", { current: currentPage, total: totalPages })}
      </span>
    )
  }
</div>
