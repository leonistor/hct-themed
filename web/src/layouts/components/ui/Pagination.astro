---
import { useTranslations } from "@/lib/utils/i18nUtils";

interface Props {
  totalDocs: number;
  hasPrevPage: boolean;
  hasNextPage: boolean;
  prevUrl: string;
  nextUrl: string;
  label: string;
}

const { totalDocs, hasPrevPage, hasNextPage, prevUrl, nextUrl, label } =
  Astro.props;

const t = await useTranslations(Astro.currentLocale as string);
---

<div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 pt-4 pb-6">
  <div class="font-medium">
    {totalDocs}
    {label}
  </div>
  {
    hasPrevPage && (
      <a href={prevUrl} class="text-gray-500">
        {t("products.paginationPrevious")} &larr;
      </a>
    )
  }
  {
    hasNextPage && (
      <a href={nextUrl} class="text-gray-500">
        {t("products.paginationNext")} &rarr;
      </a>
    )
  }
</div>
