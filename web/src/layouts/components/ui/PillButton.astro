---
interface Props {
  label: string;
  link: string;
  bgColor?: string;
}

const { label, link, bgColor } = Astro.props;
---

<a
  class="pill px-3 py-1 text-sm whitespace-nowrap text-gray-100 hover:text-gray-800"
  href={link}>
  {label}
</a>

<style define:vars={{ bgColor }}>
  .pill {
    background-color: var(--bgColor);
  }
</style>
