---
interface Props {
  label: string;
  link: string;
  bgColor?: string;
  size?: "sm" | "md" | "lg";
}

const text_sizes = {
  sm: "text-xs px-2 py-1",
  md: "text-md px-3 py-1",
  lg: "text-lg px-4 py-2",
};

const { label, link, bgColor, size = "md" } = Astro.props;
---

<a
  class:list={[
    "pill",
    text_sizes[size],
    "whitespace-nowrap text-gray-100 hover:text-gray-800",
  ]}
  href={link}>
  {label}
</a>

<style define:vars={{ bgColor }}>
  .pill {
    background-color: var(--bgColor);
  }
</style>
