---
import type { Category, Material, Partner } from "admin";
import PillButton from "./PillButton.astro";

interface Props {
  partner?: Partner;
  material?: Material;
  category?: Category;
  size?: "sm" | "md" | "lg";
}

const { partner, material, category, size = "md" } = Astro.props;

const coolors = {
  sea_green: "408c69",
  lobster_pink: "ca6b68",
  cloudy_sky: "499ce9",
  sandy_brown: "F5A051",
  tuscan_sun: "f2bf40",
};

const BG_COLORS = {
  default: "#4b5563",
  partner: `#${coolors.sea_green}`,
  material: `#${coolors.lobster_pink}`,
  category: `#${coolors.cloudy_sky}`,
};

let bgColor = BG_COLORS.default;
if (partner) bgColor = BG_COLORS.partner;
if (material) bgColor = BG_COLORS.material;
if (category) bgColor = BG_COLORS.category;

let label = "label";
if (partner) label = partner.name;
if (material) label = material.name;
if (category) label = category.name;

let link = "/";
if (partner) link = `/partners/${partner.code}`;
if (material) link = `/solutions/${material.code}`;
if (category) link = `/categories/${category.code}`;
---

<PillButton label={label} link={link} bgColor={bgColor} size={size} />
