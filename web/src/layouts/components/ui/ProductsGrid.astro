---
export const prerender = false;

import ProductCard from "@/layouts/components/cards/ProductCard.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";

import { getPayload } from "payload";
import { config as payloadConfig, type Media } from "admin";
import type { Where } from "payload";
import { cuid } from "astro:schema";
import { a } from "server/server/chunks/server_Ncxv4MlI.mjs";
import categ_tocare_c25lgx9y8b from "server/server/chunks/categ_tocare_c25lgx9y8b_3Ve1pndq.mjs";
const payload = await getPayload({ config: payloadConfig });

interface Props {
  materials_code?: string;
  category_code?: string;
  partner_code?: string;
}

const { materials_code, category_code, partner_code } = Astro.props;

const where: Where = {
  and: [
    { published: { equals: true } },
    {
      ...(materials_code
        ? { "materials.code": { contains: materials_code } }
        : {}),
    },
    {
      ...(category_code ? { "category.code": { equals: category_code } } : {}),
    },
    {
      ...(partner_code ? { "partner.code": { equals: partner_code } } : {}),
    },
  ],
};
const currentUrl = Astro.url;
let page = Number(currentUrl.searchParams.get("page"));
let limit = Number(currentUrl.searchParams.get("limit"));
page = page === 0 ? 1 : page;
limit = limit === 0 ? 9 : limit;

const products = await payload.find({
  collection: "products",
  depth: 1,
  page,
  limit,
  sort: "_order",
  where,
  select: {
    folder: false,
    images: false,
  },
});
const t = await useTranslations(Astro.currentLocale as string);

const debug = JSON.parse(JSON.stringify(products));
debug.docs = [];

const nextPageUrl = new URL(currentUrl.toString());
nextPageUrl.searchParams.set("page", String(page + 1));
const prevPageUrl = new URL(currentUrl.toString());
prevPageUrl.searchParams.set("page", String(page - 1));
---

<div class="flex flex-wrap items-center justify-end gap-4 pt-4 pb-6">
  <div class="font-medium">
    {products.totalDocs}
    {t("products.title")}
  </div>
  {
    products.hasPrevPage && (
      <a class="text-gray-500" href={prevPageUrl.toString()}>
        {t("products.paginationPrevious")} &larr;
      </a>
    )
  }
  {
    products.hasNextPage && (
      <a class="text-gray-500" href={nextPageUrl.toString()}>
        {t("products.paginationNext")} &rarr;
      </a>
    )
  }
</div>

<div
  class="grid grid-cols-1 gap-x-4 gap-y-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-10">
  {
    products.docs.map((product, index) => (
      <ProductCard product={product} index={index} />
    ))
  }
</div>
