---
export interface Props {
  id: string;
  title?: string;
  description?: string;
  class?: string;
  triggerClass?: string;
  triggerVariant?: "default" | "outline" | "ghost" | "secondary" | "destructive" | "link";
  triggerSize?: "xs" | "sm" | "base" | "md" | "lg" | "xl" | "icon" | "icon-sm";
  closeOnOverlayClick?: boolean;
}
const {
  id,
  title,
  description,
  class: className,
  triggerClass,
  triggerVariant = "outline",
  triggerSize,
  closeOnOverlayClick = true,
} = Astro.props;

const titleId = title ? `${id}-title` : undefined;
const descId = description ? `${id}-description` : undefined;
---

<button
  type="button"
  class:list={["btn", triggerClass]}
  data-variant={triggerVariant === "default" ? undefined : triggerVariant}
  data-size={triggerSize}
  onclick={`document.getElementById('${id}').showModal()`}
>
  <slot name="trigger" />
</button>

<dialog
  id={id}
  class:list={["dialog", className]}
  aria-labelledby={titleId}
  aria-describedby={descId}
  onclick={closeOnOverlayClick ? "if (event.target === this) this.close()" : undefined}
>
  <div>
    {
      (title || description) && (
        <header>
          {title && <h2 id={titleId}>{title}</h2>}
          {description && <p id={descId}>{description}</p>}
        </header>
      )
    }
    <section>
      <slot />
    </section>
    {Astro.slots.has("footer") && <footer><slot name="footer" /></footer>}
    <button
      type="button"
      class="btn"
      data-variant="ghost"
      data-size="icon-sm"
      aria-label="Close"
      onclick={`this.closest('dialog').close()`}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>
</dialog>
