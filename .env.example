# Application environment: development | production
# Consumed by admin/src/payload.config.ts (autoLogin). In Next contexts the value
# is set by Next itself; the .env value applies to non-Next runs (payload CLI).
NODE_ENV=development

# Canonical site URL. When the toml-watcher regenerates web/src/config/config.generated.json
# it overrides `site.baseUrl` from config.toml with this value (drives the Astro `site`,
# sitemap, OpenGraph tags and origin checks). Also the baseURL for e2e/playwright.config.ts.
# Use http://localhost:4321 for local dev.
BASE_URL=https://h-ct.ro

# SQLite database path, relative to the admin workspace (admin/src/payload.config.ts).
DATABASE_URL=file:../db/hct.db

# Payload CMS signing secret (admin/src/payload.config.ts).
PAYLOAD_SECRET=your-secret-here

# Base URL for the admin e2e suite (e2e/playwright.admin.config.ts): the local web dev server.
E2E_BASE_URL=http://localhost:4321

# yahoo
YAHOO_EMAIL=your-full-yahoo-email@yahoo.com
YAHOO_APP_PASSWORD=your-16-character-app-password