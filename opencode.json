{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "bearnie": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "@bearnie/mcp"]
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest", "--headless", "--browser", "chromium"]
    }
  }
}
