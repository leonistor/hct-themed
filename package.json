{
  "name": "hct-themed",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "1.3.14"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "private": true,
  "scripts": {
    "dev:web": "cd web && bun run dev",
    "dev:admin": "cd admin && bun run dev",
    "build:web": "cd web && bun run build",
    "build:admin": "cd admin && bun run build",
    "prod:web": "cd web && bun server/server/entry.mjs",
    "prod:admin": "cd admin && bun run start",
    "dev": "bun run --parallel dev:web dev:admin",
    "build": "bun run --parallel build:web build:admin",
    "prod": "bun run --parallel prod:web prod:admin",
    "e2e": "cd e2e && bunx --bun playwright test"
  },
  "type": "module",
  "workspaces": [
    "admin/**",
    "web/**",
    "e2e/**"
  ]
}
